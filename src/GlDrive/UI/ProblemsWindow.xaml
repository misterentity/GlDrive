<Window x:Class="GlDrive.UI.ProblemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Problems" Width="1080" Height="690" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Problems and health checks" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Checks only read existing state. Review a fix preview, then choose Apply preview to make that change."
                       TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{DynamicResource ForegroundDimBrush}"/>
            <WrapPanel>
                <Button x:Name="RefreshButton" Content="Refresh checks" Click="Refresh_Click"
                        Style="{DynamicResource SecondaryButton}" Padding="12,6" Margin="0,0,12,0"/>
                <TextBlock x:Name="CheckedAtText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundDimBrush}"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{DynamicResource ForegroundDimBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3*" MinWidth="330"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ProblemsGrid" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Problem_SelectionChanged"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Standing problems">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                    <DataGridTextColumn Header="Problem" Binding="{Binding Title}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="ProblemTitleText" Text="Select a problem to review its evidence." FontSize="16"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Evidence" FontWeight="SemiBold" Margin="0,16,0,5"/>
                    <TextBlock x:Name="EvidenceText" TextWrapping="Wrap"/>
                    <TextBlock Text="Suggested action" FontWeight="SemiBold" Margin="0,16,0,5"/>
                    <TextBlock x:Name="RemedyText" TextWrapping="Wrap"/>
                    <Button x:Name="PreviewButton" Content="Preview fix" Click="Preview_Click" IsEnabled="False"
                            HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}" Padding="12,6" Margin="0,16,0,0"/>
                    <Border x:Name="PreviewPanel" Visibility="Collapsed" Padding="12" Margin="0,16,0,0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Fix preview" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PreviewDescriptionText" TextWrapping="Wrap" Margin="0,8,0,8"/>
                            <TextBox x:Name="DiffText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxHeight="180" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Proposed configuration change"/>
                            <TextBlock Text="Impact" FontWeight="SemiBold" Margin="0,12,0,5"/>
                            <TextBlock x:Name="ImpactText" TextWrapping="Wrap"/>
                            <Button x:Name="ApplyButton" Content="Apply preview" Click="Apply_Click" IsEnabled="False"
                                    HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}" Padding="12,6" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
