<Window x:Class="GlDrive.UI.TagRulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Rules" Width="820" Height="620"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                <TextBlock Text="&gt;&gt; TAG RULES" Style="{DynamicResource SectionHeaderTextStyle}"/>
            </Border>
            <Grid Margin="12">
                <Border Style="{DynamicResource HudCornerBracketTLStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketTRStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketBLStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketBRStyle}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundDimBrush}"
                                   TextWrapping="Wrap"
                                   Text="Add a rule, then edit its cells. Pattern matches a release name using wildcards; enable Regex for regular expressions. An Expression such as [key] op value takes priority over Pattern."/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="TagRulesGrid"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="160"/>
                            <DataGridCheckBoxColumn Header="Regex" Binding="{Binding IsRegex}" Width="65"/>
                            <DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="*"/>
                            <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add rule" Click="Add_Click" Padding="14,4" Margin="0,0,6,0"/>
                        <Button Content="Remove" Click="Remove_Click" Padding="14,4" Margin="0,0,12,0"/>
                        <Button Content="Cancel" IsCancel="True" Padding="20,4" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Save rules" Click="Ok_Click" Padding="20,4"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
