<Window x:Class="GlDrive.UI.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Cleaner" Width="800" Height="600"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="Clean up archives" Style="{DynamicResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Find archive files beside extracted media and reclaim disk space." Margin="0,6,0,0"
                               Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Grid>
                <Border Style="{DynamicResource HudCornerBracketTLStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketTRStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketBLStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketBRStyle}"/>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan" Click="Scan_Click"
                    Padding="16,5" Style="{DynamicResource PrimaryButton}" FontSize="12"/>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"
                    AutomationProperties.Name="Choose folder to scan"
                    Padding="8,5" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}" FontSize="12"/>
            <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                       Foreground="{DynamicResource ForegroundDimBrush}"/>
            <TextBox x:Name="ScanPath" FontSize="12" Padding="4,4"
                     AutomationProperties.Name="Folder to scan"
                     Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"/>
        </DockPanel>

        <!-- Results grid -->
        <DataGrid Grid.Row="1" x:Name="ResultsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  SelectionUnit="FullRow" SelectionChanged="ResultsGrid_SelectionChanged" MinRowHeight="36" RowHeaderWidth="0"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  RowBackground="{DynamicResource SurfaceBrush}"
                  AlternatingRowBackground="{DynamicResource SurfaceLightBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Folder" Binding="{Binding FolderName}" Width="*" MinWidth="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding FolderPath}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Archives" Binding="{Binding ArchiveCount}" Width="80"/>
                <DataGridTextColumn Header="Reclaimable" Binding="{Binding SizeText}" Width="105"/>
                <DataGridTextColumn Header="Media files" Binding="{Binding MediaCount}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="4,2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Cleaned">
                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FolderPath}" TextWrapping="Wrap" Margin="12,6,12,10"
                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Scan hint -->
        <TextBlock Grid.Row="1" x:Name="ScanHint"
                   Text="Choose a folder, then scan for leftover archives.&#10;Only folders containing both archives and media are listed."
                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="{DynamicResource ForegroundDimBrush}"
                   IsHitTestVisible="False"/>

        <!-- Summary -->
        <TextBlock Grid.Row="2" x:Name="SummaryText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource ForegroundDimBrush}"/>

        <!-- Buttons -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="CleanSelectedButton" Content="Delete selected" Click="CleanSelected_Click"
                    ToolTip="Delete archives from the selected folders; media files are kept"
                    Padding="16,5" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"
                    FontSize="12" IsEnabled="False"/>
            <Button x:Name="CleanAllButton" Content="Delete all archives" Click="CleanAll_Click"
                    Padding="16,5" Style="{DynamicResource DangerButtonStyle}"
                    FontSize="12" FontWeight="SemiBold" IsEnabled="False"/>
          </StackPanel>
          <TextBlock Text="Media files are kept." TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource ForegroundDimBrush}"/>
        </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
