<Window x:Class="GlDrive.UI.SafeModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlDrive — safe mode" Width="700" Height="430" MinWidth="560" MinHeight="370"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="GlDrive is in safe mode" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Margin="0,14,0,12"/>
            <TextBlock Text="No site logins, races, scheduled agents, watched-folder extraction, control API or automatic update installation are running. Your saved settings have not been changed." TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,20,0,12">
            <Button Content="Diagnostics" Click="Diagnostics_Click" Margin="0,0,10,8"/>
            <Button Content="Recovery Center" Click="Recovery_Click" Margin="0,0,10,8"/>
            <Button x:Name="RollbackButton" Content="Roll back previous build…" Click="Rollback_Click" IsEnabled="False" Margin="0,0,0,8"/>
        </WrapPanel>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="RollbackText" Text="Inspecting local rollback availability…" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="ResumeButton" Content="Restart normally" Click="Resume_Click" Margin="0,0,10,0"/>
            <Button x:Name="ExitButton" Content="Exit" Click="Exit_Click"/>
        </WrapPanel>
    </Grid>
</Window>
