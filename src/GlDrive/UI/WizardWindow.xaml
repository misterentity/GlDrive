<Window x:Class="GlDrive.UI.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlDrive Setup Wizard" Width="780" Height="600"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                <TextBlock Text="&gt;&gt; SETUP WIZARD" Style="{DynamicResource SectionHeaderTextStyle}"/>
            </Border>
            <Grid>
                <Border Style="{DynamicResource HudCornerBracketTLStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketTRStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketBLStyle}"/>
                <Border Style="{DynamicResource HudCornerBracketBRStyle}"/>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Step indicator -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock x:Name="StepIndicator" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="5" Height="5" IsHitTestVisible="False"
                                     AutomationProperties.Name="Setup progress"/>
                    </StackPanel>

                    <!-- Step content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                        <ContentControl x:Name="StepContent" HorizontalContentAlignment="Stretch"/>
                    </ScrollViewer>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="{DynamicResource StreamBadBrush}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                    <DockPanel>
                        <Button Content="Cancel" IsCancel="True" Padding="20,6" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Content="Back" Click="Back_Click" Padding="20,6" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="NextButton" Content="Next" Click="Next_Click" IsDefault="True" Padding="20,6"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
