<UserControl x:Class="GlDrive.UI.DownloadRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sm="clr-namespace:GlDrive.UI.StreamMatrix">
    <!-- One row of the Dashboard transfer queue. DataContext = DownloadItemVm. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Border x:Name="RowRoot" Margin="0,0,0,8" Padding="14,10"
            Background="#80050F1A"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top row: release name + status chip -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ReleaseName}"
                       Style="{DynamicResource DisplayTextStyle}" FontSize="13"
                       TextTrimming="CharacterEllipsis"/>
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{DynamicResource DownloadStatusTagStyle}"
                    HorizontalAlignment="Right">
                <TextBlock Text="{Binding Status}" Style="{DynamicResource DownloadStatusTextStyle}"/>
            </Border>

            <!-- Middle row: server / category / progress micro-text, lane chips, speed -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,4,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ServerName}" Style="{DynamicResource AccentTextStyle}" FontSize="11"/>
                <TextBlock Grid.Column="1" Text=" · " Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{DynamicResource MicroTextStyle}"/>
                <TextBlock Grid.Column="3" Text=" · " Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding ProgressText}" Style="{DynamicResource MicroTextStyle}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}"/>
            </Grid>
            <sm:LaneChipsView Grid.Row="1" Grid.Column="1" DataContext="{Binding Matrix}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,8,0"
                              ToolTip="{Binding DataContext.StreamsText, ElementName=RowRoot}"
                              Visibility="{Binding DataContext.HasStreams, ElementName=RowRoot, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpeedDisplay}"
                       HorizontalAlignment="Right"
                       Style="{DynamicResource AccentTextStyle}" FontSize="11"/>

            <!-- Progress bar -->
            <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Height="5"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, FallbackValue=0}"/>
        </Grid>
    </Border>
</UserControl>
