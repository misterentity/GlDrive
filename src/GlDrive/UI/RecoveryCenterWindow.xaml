<Window x:Class="GlDrive.UI.RecoveryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recovery Center" Width="960" Height="650" MinWidth="680" MinHeight="460"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Recovery Center" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="ModeText" TextWrapping="Wrap" Margin="0,8,0,10"/>
            <TextBlock Text="Settings, FiSH keys and configured credentials can be backed up with a passphrase. Keep the passphrase separately: it is never saved. Queues, trust pins, PMs and histories are outside this backup." TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12,0,8">
                <TextBlock Text="Passphrase" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <PasswordBox x:Name="PassphraseBox" Width="240" MaxLength="1024"/>
                <Button x:Name="ExportButton" Content="Export encrypted backup" Click="Export_Click" Margin="8,0,0,0"/>
                <Button x:Name="ImportButton" Content="Import backup…" Click="Import_Click" Margin="8,0,0,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Confirm passphrase for export" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <PasswordBox x:Name="ConfirmPassphraseBox" Width="240" MaxLength="1024"/>
            </WrapPanel>
            <CheckBox x:Name="ReplaceSecrets" Content="Explicitly replace existing secrets with backup values during import" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button Content="Refresh inventory" Click="Refresh_Click" Margin="0,0,8,0"/>
                <Button x:Name="OfflineButton" Content="Restart into offline recovery" Click="Offline_Click"/>
                <Button x:Name="RollbackButton" Content="Roll back previous build…" Click="Rollback_Click" IsEnabled="False" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="RollbackText" Text="Inspecting local rollback availability…" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,12"/>
        </StackPanel>
        <DataGrid x:Name="InventoryGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="190"/>
                <DataGridTextColumn Header="Presence" Binding="{Binding Presence}" Width="90"/>
                <DataGridTextColumn Header="Recorded time (UTC)" Binding="{Binding ObservedAtUtc, StringFormat=u}" Width="155"/>
                <DataGridTextColumn Header="Meaning" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
