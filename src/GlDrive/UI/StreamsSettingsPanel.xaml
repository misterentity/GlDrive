<UserControl x:Class="GlDrive.UI.StreamsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GlDrive.UI"
             TextElement.FontFamily="{DynamicResource StreamMonoFontFamily}">
    <!-- Settings → STREAMS & UPLINKS. DataContext = SettingsViewModel. Every MultiStreamConfig
         option, the global speed limit, and the per-network uplinks with usage this period. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource StreamSparkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource StreamTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Comment" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource StreamCommentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource StreamTextFaintBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="Box" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource StreamTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource StreamSparkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,3"
                                BorderBrush="{DynamicResource StreamMatrixBorderBrush}" BorderThickness="1">
                            <!-- Explicit TextBlock: the Cyberpunk implicit TextBlock style would force 13px. -->
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       FontFamily="{DynamicResource StreamMonoFontFamily}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StreamSparkBrush}"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource LaneGlowEffect}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StreamMatrixBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StreamMatrixBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <!-- Title -->
            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource StreamSparkBrush}"
                       Effect="{DynamicResource LaneGlowEffect}" Text="⚡ STREAMS &amp; UPLINKS"/>
            <TextBlock Style="{StaticResource Comment}" Margin="0,2,0,12"
                       Text="/* one file, many links, many uplinks — plexo-style multi-stream downloads */"/>

            <!-- ENGINE -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="// STREAM ENGINE"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.ColumnSpan="2" IsChecked="{Binding MultiStreamEnabled}"
                                  Style="{StaticResource Check}">
                            <TextBlock Text="MULTI-STREAM ENABLED" FontSize="11" FontFamily="{DynamicResource StreamMonoFontFamily}" Foreground="{DynamicResource StreamTextBrush}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="// pull each download over several connections at once"/>

                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" IsChecked="{Binding BorrowIdleRaceLogin}"
                                  Style="{StaticResource Check}">
                            <TextBlock Text="BORROW IDLE RACE LOGIN" FontSize="11" FontFamily="{DynamicResource StreamMonoFontFamily}" Foreground="{DynamicResource StreamTextBrush}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="// FTP: idle race login = 2nd stream. never affects racing; handed back within ~1s"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="HTTP LANES / NETWORK"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding HttpLanesPerNetwork, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="// ranged connections per uplink for HTTP downloads (1-32)"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="FTP MIN SPLIT (MB)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding FtpMinSplitMb, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="// split an in-flight file only when both halves are at least this big"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- THROTTLE -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="// THROTTLE"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="GLOBAL SPEED LIMIT (KB/s)"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding SpeedLimitKbps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="// all downloads combined, every protocol · 0 = unlimited"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding SlowMode}"
                                  Style="{StaticResource Check}">
                            <TextBlock Text="SLOW MODE (KB/s)" FontSize="11" FontFamily="{DynamicResource StreamMonoFontFamily}" Foreground="{DynamicResource StreamTextBrush}"/>
                        </CheckBox>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding SlowModeKbps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="// temporary total cap that overrides the limit above · also in the tray ⚡"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- UPLINKS -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="⟳ RESCAN" Command="{Binding RefreshNetworksCommand}"
                                Style="{StaticResource MiniButton}" ToolTip="Re-scan network adapters"/>
                        <TextBlock Style="{StaticResource Section}" Text="// NETWORK UPLINKS" Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Comment}" Margin="0,0,0,10"
                               Text="// none ticked = default route only (unchanged). tick 2+ uplinks (ethernet + tether) to combine them. KB/s and CAP: 0 = unlimited"/>

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="USE" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="2" Text="ADAPTER // IPV4" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="3" Text="ALIAS" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="4" Text="KB/s" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="5" Text="CAP GB" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="6" Text="PERIOD" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="7" Text="USAGE" Style="{StaticResource ColHeader}"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource StreamGridLineBrush}" Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding Networks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:NetworkRowViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status LED -->
                                    <Ellipse x:Name="Led" Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Left"
                                             Fill="{DynamicResource StreamLedOffBrush}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Use, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding NameDisplay}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource StreamTextBrush}"/>
                                        <TextBlock x:Name="Ip" Text="{Binding AddressDisplay}" FontSize="10"
                                                   FontFamily="{DynamicResource StreamMonoFontFamily}"
                                                   Foreground="{DynamicResource StreamTextDimBrush}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="3" Margin="0,0,6,0" Style="{StaticResource Box}"
                                             Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" Margin="0,0,6,0" Style="{StaticResource Box}"
                                             Text="{Binding LimitKbps, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="5" Margin="0,0,6,0" Style="{StaticResource Box}"
                                             Text="{Binding AllowanceGb, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Column="6" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11"
                                              ItemsSource="{x:Static ui:NetworkRowViewModel.PeriodOptions}"
                                              SelectedItem="{Binding Period}"/>
                                    <!-- Usage this period -->
                                    <StackPanel Grid.Column="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="UsageText" Text="{Binding UsageText}" FontSize="10"
                                                   Foreground="{DynamicResource StreamTextDimBrush}"/>
                                        <Grid x:Name="UsageBar" Height="4" Margin="0,3,0,0" Visibility="Collapsed">
                                            <Border Background="{DynamicResource StreamUsageTrackBrush}"/>
                                            <ProgressBar x:Name="UsageFill" Minimum="0" Maximum="1" Value="{Binding UsageFraction, Mode=OneWay}"
                                                         Height="4" Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource StreamUsageBarBrush}">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid x:Name="PART_Track">
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                                    Background="{TemplateBinding Foreground}"
                                                                    Effect="{DynamicResource LaneGlowEffect}"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                        </Grid>
                                    </StackPanel>
                                    <Button Grid.Column="8" Content="RESET" VerticalAlignment="Center"
                                            Style="{StaticResource MiniButton}" ToolTip="Zero this uplink's recorded data usage"
                                            Command="{Binding DataContext.ResetUsageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="Led" Property="Fill" Value="{DynamicResource StreamLedOnBrush}"/>
                                        <Setter TargetName="Led" Property="Effect" Value="{DynamicResource StreamLedGlowEffect}"/>
                                        <Setter TargetName="Ip" Property="Foreground" Value="{DynamicResource StreamSparkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAllowance}" Value="True">
                                        <Setter TargetName="UsageBar" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverAllowance}" Value="True">
                                        <Setter TargetName="UsageFill" Property="Foreground" Value="{DynamicResource StreamBadBrush}"/>
                                        <Setter TargetName="UsageText" Property="Foreground" Value="{DynamicResource StreamBadBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- HOW IT WORKS (read-only) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource StreamMatrixHeaderBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="// HOW IT WORKS"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="FTP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LaneBrush0}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource StreamTextBrush}"
                                   Text="main login + the borrowed race login while the site is idle · CPSV sites only · data sockets bind to the chosen uplink; control and racing stay on the default route"/>
                        <TextBlock Grid.Row="1" Text="HTTP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LaneBrush1}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource StreamTextBrush}"
                                   Text="ranged multi-connection · N lanes per uplink steal work from each other · 403/429/503 backs a lane off for 60s"/>
                        <TextBlock Grid.Row="2" Text="TORRENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LaneBrush2}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource StreamTextBrush}"
                                   Text="speed caps only (global limit + slow mode) · peers use the default route"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
