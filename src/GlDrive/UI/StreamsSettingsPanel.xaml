<UserControl x:Class="GlDrive.UI.StreamsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GlDrive.UI"
             FontFamily="{DynamicResource StreamMonoFontFamily}" FontSize="12">
    <!-- Settings → STREAMS & UPLINKS. DataContext = SettingsViewModel. Every MultiStreamConfig
         option, the global speed limit, and the per-network uplinks with usage this period. -->
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Comment" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Box" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource StreamMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12,16,14">
            <!-- Title -->
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                       Text="Streams &amp; uplinks"/>
            <TextBlock Style="{StaticResource Comment}" Margin="0,2,0,12"
                       Text="Use multiple connections and networks for your downloads. Save settings to apply changes."/>

            <!-- ENGINE -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="01 / CONNECTIONS"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="40"/>
                            <RowDefinition Height="Auto" MinHeight="40"/>
                            <RowDefinition Height="Auto" MinHeight="40"/>
                            <RowDefinition Height="Auto" MinHeight="40"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.ColumnSpan="2" IsChecked="{Binding MultiStreamEnabled}"
                                  Style="{StaticResource Check}">
                            <TextBlock Text="Enable multi-stream" FontSize="13" FontFamily="{DynamicResource StreamMonoFontFamily}" Foreground="{DynamicResource ForegroundBrush}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="Use several connections for a single file."/>

                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" IsChecked="{Binding BorrowIdleRaceLogin}"
                                  Style="{StaticResource Check}">
                            <TextBlock Text="Borrow idle race login" FontSize="13" FontFamily="{DynamicResource StreamMonoFontFamily}" Foreground="{DynamicResource ForegroundBrush}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="Adds a second FTP stream while racing is idle. Returned when a race needs it."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="HTTP streams / network"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding HttpLanesPerNetwork, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="Connections per network for HTTP downloads (1–32)."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Minimum FTP split (MB)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding FtpMinSplitMb, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="Split files only when both parts meet this size."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- THROTTLE -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="02 / SPEED LIMITS"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="40"/>
                            <RowDefinition Height="Auto" MinHeight="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Download limit (KB/s)"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 Text="{Binding SpeedLimitKbps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="All downloads combined. Enter 0 for unlimited."/>

                        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding SlowMode}"
                                  Style="{StaticResource Check}">
                            <TextBlock Text="Slow mode (KB/s)" FontSize="13" FontFamily="{DynamicResource StreamMonoFontFamily}" Foreground="{DynamicResource ForegroundBrush}"/>
                        </CheckBox>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Style="{StaticResource Box}"
                                 IsEnabled="{Binding SlowMode}" Text="{Binding SlowModeKbps, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Comment}"
                                   Text="Temporarily overrides the total limit. Also available in the tray."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- UPLINKS -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Rescan networks" Command="{Binding RefreshNetworksCommand}"
                                Style="{StaticResource SecondaryButton}" ToolTip="Re-scan network adapters"/>
                        <TextBlock Style="{StaticResource Section}" Text="03 / NETWORK UPLINKS" Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Comment}" Margin="0,0,0,10"
                               Text="Leave all networks unchecked to use the default route. Select two or more to combine them. Speed limit and allowance: 0 = unlimited."/>

                    <TextBlock Text="No network adapters found. Connect a network and choose Rescan networks."
                               TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource ForegroundDimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Networks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Networks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:NetworkRowViewModel}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="ConnectionState" DockPanel.Dock="Right" Text="Offline" FontSize="12"
                                                       Foreground="{DynamicResource ForegroundDimBrush}" Margin="12,0,0,0"/>
                                            <CheckBox IsChecked="{Binding Use, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding NameDisplay}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NameDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AddressDisplay}" FontSize="12" Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                        <WrapPanel>
                                            <StackPanel Width="148" Margin="0,0,12,8">
                                                <TextBlock Text="Display name" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Network display name"/>
                                            </StackPanel>
                                            <StackPanel Width="132" Margin="0,0,12,8">
                                                <TextBlock Text="Speed limit (KB/s)" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding LimitKbps, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Network speed limit"/>
                                            </StackPanel>
                                            <StackPanel Width="132" Margin="0,0,12,8">
                                                <TextBlock Text="Data allowance (GB)" FontSize="12" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding AllowanceGb, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Network data allowance"/>
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,0,8">
                                                <TextBlock Text="Allowance period" FontSize="12" Margin="0,0,0,5"/>
                                                <ComboBox ItemsSource="{x:Static ui:NetworkRowViewModel.PeriodOptions}" SelectedItem="{Binding Period}" AutomationProperties.Name="Network allowance period"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Reset usage" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                                    ToolTip="Reset this network's recorded data usage to zero"
                                                    Command="{Binding DataContext.ResetUsageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="UsageText" Text="{Binding UsageText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                <ProgressBar x:Name="UsageFill" Minimum="0" Maximum="1" Value="{Binding UsageFraction, Mode=OneWay}"
                                                             Height="6" Margin="0,6,0,0" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Data allowance used"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="ConnectionState" Property="Text" Value="Connected"/>
                                        <Setter TargetName="ConnectionState" Property="Foreground" Value="{DynamicResource StreamSparkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAllowance}" Value="True">
                                        <Setter TargetName="UsageFill" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverAllowance}" Value="True">
                                        <Setter TargetName="UsageFill" Property="Foreground" Value="{DynamicResource StreamBadBrush}"/>
                                        <Setter TargetName="UsageText" Property="Foreground" Value="{DynamicResource StreamBadBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- HOW IT WORKS (read-only) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="04 / TRANSFER BEHAVIOR"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="FTP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource LaneBrush0}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="main login + the borrowed race login while the site is idle · CPSV sites only · data sockets bind to the chosen uplink; control and racing stay on the default route"/>
                        <TextBlock Grid.Row="1" Text="HTTP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource LaneBrush1}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="ranged multi-connection · N lanes per uplink steal work from each other · 403/429/503 backs a lane off for 60s"/>
                        <TextBlock Grid.Row="2" Text="TORRENT" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource LaneBrush2}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="speed caps only (global limit + slow mode) · peers use the default route"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
