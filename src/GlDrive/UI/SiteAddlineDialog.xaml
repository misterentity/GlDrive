<Window x:Class="GlDrive.UI.SiteAddlineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send addline to site" Width="640" Height="520"
        MinWidth="480" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                <TextBlock x:Name="HeaderText" Text="&gt;&gt; SEND ADDLINE TO SITE" Style="{DynamicResource SectionHeaderTextStyle}"/>
            </Border>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Site:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ServerPicker" DisplayMemberPath="Label" SelectionChanged="ServerPicker_SelectionChanged"
                              AutomationProperties.Name="Site to send the addline to"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Commands (edit before sending; one per line — SITE ADDUSER, GADDUSER or ADDIP only):"
                           TextWrapping="Wrap" Style="{DynamicResource DimTextStyle}" Margin="0,0,0,4"/>

                <TextBox Grid.Row="2" x:Name="CommandsBox"
                         AutomationProperties.Name="Addline commands"
                         FontFamily="Consolas" FontSize="12.5"
                         AcceptsReturn="True" TextWrapping="NoWrap" TextChanged="CommandsBox_TextChanged"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceBrush}"/>

                <TextBlock Grid.Row="3" Text="Site replies:" Style="{DynamicResource DimTextStyle}" Margin="0,10,0,4"/>

                <TextBox Grid.Row="4" x:Name="RepliesBox" IsReadOnly="True"
                         AutomationProperties.Name="Site replies"
                         FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceBrush}"/>

                <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="380" Style="{DynamicResource DimTextStyle}"/>
                    <Button DockPanel.Dock="Right" x:Name="SendButton" Content="Send" Click="Send_Click" IsDefault="True"
                            Padding="20,6" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"/>
                    <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="Close" Click="Close_Click" IsCancel="True"
                            Padding="20,6" Style="{StaticResource SecondaryButton}"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
