<Window x:Class="GlDrive.UI.CertificateDecisionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificate decisions" Width="800" Height="550" MinWidth="600" MinHeight="360"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="A TLS certificate needs your decision" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="The affected endpoint is parked. Verify the full new fingerprint independently before accepting. Other endpoints continue normally. Closing this window keeps the change rejected."
                       TextWrapping="Wrap" Margin="0,8,0,8"/>
            <Button Content="Refresh decisions" Click="Refresh_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Decisions">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding HostPort}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="Previously trusted SHA-256" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding OldFingerprint}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                <TextBlock Text="New SHA-256" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding NewFingerprint}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding Subject, StringFormat=Subject: {0}}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Issuer, StringFormat=Issuer: {0}}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NotAfter, StringFormat=Valid until: {0:u}}"/>
                                <TextBlock Text="{Binding KeptRejected, StringFormat=Explicitly kept rejected: {0}}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="I verified this fingerprint — accept" Tag="{Binding Id}" Click="Accept_Click" Margin="0,0,8,0"/>
                                    <Button Content="Keep rejecting" Tag="{Binding Id}" Click="Reject_Click" Margin="0,0,8,0"/>
                                    <Button Content="Keep saved pin and retry" Tag="{Binding Id}" Click="RetrySavedPin_Click" IsEnabled="{Binding CanRetrySavedPin}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
