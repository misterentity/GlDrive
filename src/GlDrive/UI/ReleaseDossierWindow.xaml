<Window x:Class="GlDrive.UI.ReleaseDossierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Release dossier" Width="1100" Height="720" MinWidth="750" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Release dossier" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Join existing local observations and preview current configuration gates. This view never starts a race, download, login or site search."
                       TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Exact release name" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReleaseBox" MaxLength="1024" AutomationProperties.Name="Exact release name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Section (optional)" Margin="0,0,0,4"/>
                    <TextBox x:Name="SectionBox" MaxLength="256" AutomationProperties.Name="Release section"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Window" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DaysBox" SelectedIndex="2" AutomationProperties.Name="Dossier time window">
                        <ComboBoxItem Content="1 day" Tag="1"/><ComboBoxItem Content="7 days" Tag="7"/>
                        <ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="90 days" Tag="90"/>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="3" Content="Refresh" Click="Refresh_Click" Padding="12,6"
                        VerticalAlignment="Bottom" Margin="0,0,8,0" Style="{DynamicResource SecondaryButton}"/>
                <Button x:Name="CancelButton" Grid.Column="4" Content="Cancel" Click="Cancel_Click" Padding="12,6"
                        VerticalAlignment="Bottom" IsEnabled="False" Style="{DynamicResource SecondaryButton}"/>
            </Grid>
            <TextBlock x:Name="StatusText" Text="Enter a release and choose Refresh. Missing observations are not evidence that a release is absent."
                       TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource ForegroundDimBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Observed timeline">
                <DataGrid x:Name="TimelineGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Observed release timeline">
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="10"/></DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UTC time" Binding="{Binding Time, StringFormat={}{0:u}}" Width="165"/>
                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="130"/>
                        <DataGridTextColumn Header="Server" Binding="{Binding ServerId}" Width="140"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="What would happen now">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Predicted from current local configuration and evidence only. Unknown site contents, connectivity and later checks can change the outcome. No operational action is performed."
                               TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <DataGrid x:Name="PredictionsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Predicted local release decisions">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="10"/></DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerId}" Width="140"/>
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="150"/>
                            <DataGridTextColumn Header="Predicted verdict" Binding="{Binding Verdict}" Width="150"/>
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
