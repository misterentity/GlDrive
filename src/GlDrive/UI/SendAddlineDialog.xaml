<Window x:Class="GlDrive.UI.SendAddlineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send my addline" Width="600" Height="430"
        MinWidth="460" MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                <TextBlock x:Name="HeaderText" Text="&gt;&gt; SEND MY ADDLINE" Style="{DynamicResource SectionHeaderTextStyle}"/>
            </Border>
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Style="{DynamicResource DimTextStyle}" Margin="0,0,0,10"
                           Text="The siteop adds you with this line. When they reply with the site's address, right-click their message and choose Add server — this login is filled in for you."/>

                <TextBlock Grid.Row="1" Text="Username" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UserBox" Margin="0,0,0,6"
                         TextChanged="Fields_Changed" AutomationProperties.Name="Username"/>

                <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="PassBox" Margin="0,0,0,6" FontFamily="Consolas"
                         TextChanged="Fields_Changed" AutomationProperties.Name="Password"/>
                <Button Grid.Row="2" Grid.Column="2" Content="New" Click="NewPassword_Click" Margin="6,0,0,6" Padding="10,2"
                        Style="{StaticResource SecondaryButton}" ToolTip="Generate a new random password"/>

                <TextBlock Grid.Row="3" Text="ident@ip" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="MasksBox" Margin="0,0,0,6" FontFamily="Consolas"
                         TextChanged="Fields_Changed" AutomationProperties.Name="ident at IP masks"
                         ToolTip="One or more masks, e.g. *@1.2.3.4 (a bare IP becomes *@ip)"/>
                <Button Grid.Row="3" Grid.Column="2" x:Name="DetectButton" Content="Detect my IP" Click="DetectIp_Click" Margin="6,0,0,6" Padding="10,2"
                        Style="{StaticResource SecondaryButton}" ToolTip="Looks up your public IP at api.ipify.org"/>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="Message to send:" Style="{DynamicResource DimTextStyle}" Margin="0,6,0,4"/>
                <TextBox Grid.Row="5" Grid.ColumnSpan="3" x:Name="PreviewBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                         TextWrapping="Wrap" VerticalAlignment="Top" MinHeight="44"
                         Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="Addline preview"/>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock x:Name="EncryptionText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"
                                   Style="{DynamicResource DimTextStyle}"/>
                        <Button DockPanel.Dock="Right" x:Name="SendButton" Content="Send" Click="Send_Click" IsDefault="True"
                                Padding="20,6" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"/>
                        <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsCancel="True"
                                Padding="20,6" Style="{StaticResource SecondaryButton}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
