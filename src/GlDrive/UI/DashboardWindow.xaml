<Window x:Class="GlDrive.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GlDrive.UI"
        xmlns:sm="clr-namespace:GlDrive.UI.StreamMatrix"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="GlDrive Dashboard" Width="1440" Height="900"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource MonoFontFamily}">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- FilterChipStyle, DownloadQueueItemStyle -->
            <ResourceDictionary Source="/GlDrive;component/UI/DashboardControls.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <ui:ImageUrlConverter x:Key="ImageUrlConverter"/>
        <ui:JoinListConverter x:Key="JoinList"/>
        <ui:HasSelectionConverter x:Key="HasSelectionConverter"/>
        <ui:StatusGlyphConverter x:Key="StatusGlyph"/>
        <ui:ValueEqualsConverter x:Key="ValueEquals"/>
        <ui:InverseBooleanConverter x:Key="InverseBoolean"/>
        <ui:StatusSegmentsConverter x:Key="StatusSegments"/>
        <ui:DistinctTextVisibilityConverter x:Key="DistinctTextVisibility"/>
        <Style x:Key="ToolbarDividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0,12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource LineDimBrush}"/>
        </Style>
        <!-- Race card state chip: glyph + word; lime is reserved for live FXP/race transfer. -->
        <Style x:Key="RaceStatusTagStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Signature2Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="BorderBrush" Value="{DynamicResource LineDimBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="BorderBrush" Value="{DynamicResource LineDimBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RaceStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Signature2Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionalConsoleTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TruncatedCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style x:Key="ModeTabStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0"
                                Padding="{TemplateBinding Padding}" Cursor="Hand"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceLightBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundDimBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentDimBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- TOP BAR (cyberpunk shell chrome)                                -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo block -->
                <Border Grid.Column="0" Background="{DynamicResource TopBarLogoBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"
                        Padding="16,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&gt;_" FontFamily="{DynamicResource MonoFontFamily}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Signature2Brush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GLDRIVE" FontFamily="{DynamicResource MonoFontFamily}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding VersionTagline}" ToolTip="{Binding VersionTagline}"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="10"
                                       Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentSectionText" Text="Overview" FontFamily="{DynamicResource MonoFontFamily}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="CurrentSectionHint" Text="Connections, transfers, and app activity at a glance."
                               FontSize="12" Foreground="{DynamicResource ForegroundDimBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <TextBlock x:Name="UtcClockText" Text="--:--:-- UTC" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                               Foreground="{DynamicResource ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Shortcuts" Click="Shortcuts_Click" Padding="12,7" Margin="0,0,8,0"
                            Style="{DynamicResource SecondaryButton}" ToolTip="Keyboard shortcuts (?)"/>
                    <Button Content="Settings" Click="Settings_Click" Padding="12,7"
                            Style="{DynamicResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Padding="0" Style="{DynamicResource SidebarTabControlStyle}">

            <!-- ===== DASHBOARD group ===== -->
            <TabItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" Padding="14,3,14,0">
                <TabItem.Header>
                    <TextBlock Text="// DASHBOARD" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                </TabItem.Header>
            </TabItem>

            <!-- Overview Tab -->
            <TabItem x:Name="OverviewTab" AutomationProperties.Name="Overview" IsSelected="True">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="01" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Overview" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <DockPanel Margin="12">
                    <!-- Stat cards row -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="CONNECTED SERVERS" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding MountedServerCount}" Style="{DynamicResource StatCardValueStyle}"/>
                                            <TextBlock Text="/" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource TextFaintBrush}" Margin="6,0"/>
                                            <TextBlock Text="{Binding ConfiguredServerCount}" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource TextDimBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="ACTIVE DOWNLOADS" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding ActiveDownloadCount, FallbackValue=0}" Style="{DynamicResource StatCardValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="QUEUED" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding QueuedDownloadCount, FallbackValue=0}" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource WarnBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="COMPLETED" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding CompletedTodayCount, FallbackValue=0}" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource GoodBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <!-- Connection inventory and throughput sit above the compact telemetry strip. -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource HudPanelStyle}" Margin="0,0,4,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                    <TextBlock Text="SERVER CONNECTIONS" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding MountedServerStatus}" Margin="12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Style="{DynamicResource ServerStatusTagStyle}" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding SiteTag}" Style="{DynamicResource ServerStatusTextStyle}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Host}" Style="{DynamicResource MicroTextStyle}" Margin="0,4,0,8"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextDimBrush}">
                                                                <Run Text="POOL "/><Run Text="{Binding CapacityUsedDisplay}"/><Run Text=" / "/><Run Text="{Binding CapacityTotalDisplay}"/>
                                                                <Run Text="    "/><Run Text="{Binding CapacityPercent, StringFormat=N0}"/><Run Text="%"/>
                                                            </TextBlock>
                                                            <!-- Shown only when it adds to the chip (no second "OFFLINE"). -->
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Style="{DynamicResource MicroTextStyle}" FontSize="10">
                                                                <TextBlock.Visibility>
                                                                    <MultiBinding Converter="{StaticResource DistinctTextVisibility}">
                                                                        <Binding Path="StatusLine"/>
                                                                        <Binding Path="SiteTag"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Visibility>
                                                            </TextBlock>
                                                        </Grid>
                                                        <ProgressBar Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding CapacityPercent, Mode=OneWay}"
                                                                     Style="{DynamicResource SegmentedMeterStyle}" Height="6"
                                                                     Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Connection pool usage"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <!-- Top-right: Throughput -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{DynamicResource HudPanelStyle}" Margin="4,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                    <TextBlock Text="THROUGHPUT" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                </Border>
                                <Grid>
                                    <DockPanel Margin="12">
                                        <!-- Rx / Tx numbers -->
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="DOWNLOAD SPEED" Style="{DynamicResource MicroTextStyle}"/>
                                                <TextBlock Text="{Binding RxRateDisplay}" Style="{DynamicResource DisplayTextStyle}"
                                                           FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="FXP TRANSFER SPEED" Style="{DynamicResource MicroTextStyle}"/>
                                                <TextBlock Text="{Binding TxRateDisplay}" Style="{DynamicResource DisplayTextStyle}"
                                                           FontSize="22" Foreground="{DynamicResource Signature2Brush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Bottom" Text="Downloads · last 2 minutes · 0–50 MiB/s" FontSize="12"
                                                   Margin="0,6,0,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
                                        <!-- Area chart: an instrument well in the stream-matrix style -->
                                        <Border Height="96" Background="{DynamicResource StreamMatrixHeaderBrush}"
                                                BorderBrush="{DynamicResource StreamGridLineBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <ui:TelemetrySparkline Points="{Binding ThroughputPoints}" YRange="40" ValueAtTop="50" Unit="MiB/s"
                                                                       SpanLabel="-2m" Margin="1"
                                                                       AutomationProperties.Name="Download throughput, last 2 minutes"/>
                                                <Rectangle Fill="{DynamicResource ScanlineOverlayBrush}" Opacity="0.6" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource HudPanelStyle}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Every column: label, value on one baseline, then an optional meter. -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="CPU" Style="{DynamicResource MicroTextStyle}"/>
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="16" Margin="0,3,0,0"><Run Text="{Binding TelemetryCpuPercent, StringFormat=N0}"/><Run Text=" %"/></TextBlock>
                                    <ProgressBar Margin="0,5,0,0" Minimum="0" Maximum="100" Value="{Binding TelemetryCpuPercent, Mode=OneWay}"
                                                 Style="{DynamicResource SegmentedMeterStyle}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="CPU usage"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="MEMORY" Style="{DynamicResource MicroTextStyle}"/>
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="16" Margin="0,3,0,0"><Run Text="{Binding TelemetryMemoryMb, StringFormat=N0}"/><Run Text=" MB"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="CONNECTIONS" Style="{DynamicResource MicroTextStyle}"/>
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="16" Margin="0,3,0,0"><Run Text="{Binding TelemetryPoolUtilization, StringFormat=N0}"/><Run Text=" %"/></TextBlock>
                                    <ProgressBar Margin="0,5,0,0" Minimum="0" Maximum="100" Value="{Binding TelemetryPoolUtilization, Mode=OneWay}"
                                                 Style="{DynamicResource SegmentedMeterStyle}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Connection pool utilization"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                    <TextBlock Text="UPTIME" Style="{DynamicResource MicroTextStyle}"/>
                                    <TextBlock Text="{Binding TelemetryUptime}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="16" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="THREADS" Style="{DynamicResource MicroTextStyle}"/>
                                    <TextBlock Text="{Binding TelemetryThreadCount}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="16" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Bottom-right: Operations Log -->
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{DynamicResource HudPanelStyle}" Margin="0,8,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                    <TextBlock Text="OPERATIONS LOG / RECENT EVENTS" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                </Border>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding OperationsLogPreview}"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextDimBrush}"
                                                   TextWrapping="NoWrap"
                                                   Margin="12"/>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Notifications Tab -->
            <TabItem AutomationProperties.Name="Notifications">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="02" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Notifications" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <DockPanel Margin="12">
                    <!-- Toolbar (preserved as-is) -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="0" Padding="8,6" Margin="0,0,0,10">
                        <WrapPanel ItemHeight="40">
                            <Button Content="Download" Command="{Binding DownloadNotificationCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}" IsEnabled="{Binding SelectedItem, ElementName=NotificationsGrid, Converter={StaticResource HasSelectionConverter}}"/>
                            <Button Content="Race" Command="{Binding RaceNotificationCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}"
                                    ToolTip="Start FXP race for selected release across all configured servers" IsEnabled="{Binding SelectedItem, ElementName=NotificationsGrid, Converter={StaticResource HasSelectionConverter}}"/>
                            <Button Content="Clear All" Command="{Binding ClearNotificationsCommand}"
                                    Padding="12,6" Margin="0,0,12,0" Style="{DynamicResource SecondaryButton}"/>
                            <Button Content="Remove selected" Command="{Binding RemoveSelectedNotificationsCommand}"
                                    Padding="12,6" Margin="0,0,12,0" Style="{DynamicResource SecondaryButton}"/>
                            <TextBlock Text="Filter releases" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
                            <TextBox AutomationProperties.Name="Filter notifications by release name" Text="{Binding NotificationFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                     ToolTip="Filter by release name"/>
                            <ComboBox ItemsSource="{Binding NotificationCategories}"
                                      SelectedItem="{Binding NotificationFilterCategory}" AutomationProperties.Name="Filter notifications by category"
                                      Width="110" Margin="0,0,6,0" ToolTip="Filter by category"/>
                            <ComboBox ItemsSource="{Binding NotificationServers}"
                                      SelectedItem="{Binding NotificationFilterServer}" AutomationProperties.Name="Filter notifications by server"
                                      Width="110" ToolTip="Filter by server"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="8,6" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Saved views" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
                                <ComboBox ItemsSource="{Binding FeedViews}" SelectedItem="{Binding SelectedFeedView}" DisplayMemberPath="Display"
                                          Width="230" Margin="0,0,6,0" AutomationProperties.Name="Saved feed views with unread counts"/>
                                <TextBox Text="{Binding FeedViewName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,6,0"
                                         MaxLength="80" AutomationProperties.Name="Feed view name" ToolTip="Name for the current release, category and server filters"/>
                                <Button Content="Save view" Command="{Binding SaveFeedViewCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4"/>
                                <Button Content="Mark view read" Command="{Binding MarkFeedViewReadCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4"/>
                                <Button Content="Remove view" Command="{Binding RemoveFeedViewCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4"/>
                                <Button Content="Clear feed mutes" Command="{Binding ClearFeedMutesCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,4"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding FeedViewStatus}" Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- DETAIL HUD panel -->
                    <Border DockPanel.Dock="Bottom" Height="180" Margin="0,10,0,0"
                            Style="{DynamicResource HudPanelStyle}"
                            Visibility="{Binding HasNotificationSelection, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="DETAIL" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>
                            <Grid>
                                <DockPanel Margin="14">
                                    <Border DockPanel.Dock="Left" Width="95" Margin="0,0,16,0"
                                            CornerRadius="4" ClipToBounds="True"
                                            Background="{DynamicResource SurfaceLightBrush}"
                                            Visibility="{Binding HasNotificationPoster, Converter={StaticResource BoolToVisibility}}">
                                        <Image Stretch="UniformToFill" VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding NotificationPosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=120}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock FontWeight="Bold" FontSize="16"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Text="{Binding SelectedNotificationItem.ReleaseName}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding NotificationRating}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding NotificationGenres}" FontSize="12.5"
                                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                                       Margin="14,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding NotificationPlot}" TextWrapping="Wrap"
                                                   MaxHeight="65" FontSize="12.5" Margin="0,8,0,0"
                                                   LineHeight="18"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <!-- NEW RELEASE FEED HUD panel wrapping the DataGrid -->
                    <Border Style="{DynamicResource HudPanelStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, ElementName=NotificationsGrid, StringFormat={}{0} releases}"
                                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"/>
                                    <TextBlock Text="NEW RELEASE FEED" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <Grid>
<DataGrid ItemsSource="{Binding NotificationItems}"
                                          SelectedItem="{Binding SelectedNotificationItem}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Extended" SelectionChanged="NotificationsGrid_SelectionChanged" GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column" CanUserAddRows="False"
                                          Background="Transparent" BorderThickness="0"
                                          x:Name="NotificationsGrid"
                                          PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                          MouseMove="DragSource_MouseMove">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Download" Command="{Binding DownloadNotificationCommand}" FontWeight="Bold"/>
                                            <MenuItem Header="Race / Spread" Command="{Binding RaceNotificationCommand}"/>
                                            <MenuItem Header="Remove selected from feed" Command="{Binding RemoveSelectedNotificationsCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Search on Servers" Command="{Binding SearchNotificationOnServersCommand}"/>
                                            <MenuItem Header="Copy Release Name" Command="{Binding CopyNotificationReleaseCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Mute category in feed for this server" Command="{Binding MuteFeedCategoryCommand}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding DownloadNotificationCommand}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="160"/>
                                        <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="90"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                                        <DataGridTextColumn Header="Release" Binding="{Binding ReleaseName}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=NotificationsGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No releases to show" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="New releases from connected servers appear here. If you have filters applied, try another category or server." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Wishlist Tab -->
            <TabItem AutomationProperties.Name="Wishlist">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="03" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Wishlist" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                            <TextBlock Text="WISHLIST" Style="{DynamicResource SectionHeaderTextStyle}"/>
                        </Border>
                        <Grid>
                            <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="0" Padding="8,6" Margin="0,0,0,10">
                        <WrapPanel ItemHeight="40">
                            <Button Content="+ Movie" Command="{Binding AddMovieCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}"/>
                            <Button Content="+ TV Show" Command="{Binding AddTvShowCommand}"
                                    Padding="12,6" Margin="0,0,12,0" Style="{DynamicResource PrimaryButton}"/>
                            <Button Content="Remove" Command="{Binding RemoveWishlistCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}" IsEnabled="{Binding SelectedItem, ElementName=WishlistGrid, Converter={StaticResource HasSelectionConverter}}"/>
                            <Button Content="Pause / Resume" Command="{Binding TogglePauseCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}" IsEnabled="{Binding SelectedItem, ElementName=WishlistGrid, Converter={StaticResource HasSelectionConverter}}"/>
                            <ComboBox ItemsSource="{Binding WishlistQualities}" SelectedItem="{Binding BulkWishlistQuality}" Width="100" Margin="0,0,6,0"
                                      AutomationProperties.Name="Resolution for selected wishlist items"/>
                            <Button Content="Set resolution" Command="{Binding SetWishlistQualityCommand}" Padding="10,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"/>
                            <Button Content="Completed" Command="{Binding SetWishlistStatusCommand}" CommandParameter="Completed" Padding="10,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"/>
                            <Button Content="Watching" Command="{Binding SetWishlistStatusCommand}" CommandParameter="Watching" Padding="10,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"/>
                            <Button Content="Refresh Info" Command="{Binding RefreshMetadataCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"
                                    ToolTip="Fetch posters, ratings, and plots for all items"/>
                            <Button Content="Release dates" Command="{Binding RefreshWishlistCalendarCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"
                                    ToolTip="Look up the selected movie's dates; unknown dates never block downloads"/>
                            <Button Content="Collection gaps" Click="CollectionGaps_Click" Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"
                                    ToolTip="Explicitly compare a movie's TMDB collection with the library and downloads"/>
                            <CheckBox Content="Allow CAM/TS/TC" IsThreeState="True" IsChecked="{Binding SelectedWishlistAllowsLowSources}"
                                      IsEnabled="{Binding HasWishlistSelection}" VerticalAlignment="Center" Margin="4,0,10,0"
                                      ToolTip="Indeterminate uses the default/profile. Checked permits low sources; unchecked blocks them. Low sources always keep the movie open."/>
                            <Button Content="Export" Command="{Binding ExportWishlistCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"/>
                            <Button Content="Import" Command="{Binding ImportWishlistCommand}"
                                    Padding="12,6" Style="{DynamicResource SecondaryButton}"/>
                            <TextBlock Text="{Binding CalendarStatus}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Height="155"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Margin="0,10,0,0" Padding="14"
                            Visibility="{Binding HasWishlistSelection, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="95" Margin="0,0,16,0"
                                    CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceLightBrush}"
                                    Visibility="{Binding HasSelectedPoster, Converter={StaticResource BoolToVisibility}}">
                                <Image Stretch="UniformToFill" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding SelectedPosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=120}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ForegroundBrush}">
                                    <Run Text="{Binding SelectedWishlistItem.Title, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding SelectedWishlistItem.Year, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding SelectedRating}" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectedGenres}" FontSize="12.5"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               Margin="14,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedPlot}" TextWrapping="Wrap"
                                           MaxHeight="65" FontSize="12.5" Margin="0,8,0,0"
                                           LineHeight="18"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
<DataGrid x:Name="WishlistGrid" ItemsSource="{Binding WishlistItems}"
                              SelectedItem="{Binding SelectedWishlistItem}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionChanged="WishlistGrid_SelectionChanged" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Downloaded" Binding="{Binding GrabbedCount}" Width="100"/>
                            <DataGridTextColumn Header="Theatrical" Binding="{Binding TheatricalDate}" Width="95"/>
                            <DataGridTextColumn Header="Digital" Binding="{Binding DigitalDate}" Width="95"/>
                            <DataGridTextColumn Header="Physical" Binding="{Binding PhysicalDate}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=WishlistGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Build your wishlist" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Add a movie or TV show above to track releases and download matching titles automatically." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Downloads Tab -->
            <TabItem AutomationProperties.Name="Downloads">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="04" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Downloads" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <DockPanel Margin="12">
                    <!-- Stats cards row -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <UniformGrid Columns="4">
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="ACTIVE" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding ActiveDownloadCount, FallbackValue=—}" Style="{DynamicResource StatCardValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="QUEUED" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding QueuedDownloadCount, FallbackValue=—}" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource WarnBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="NEEDS ATTENTION" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding FailedDownloadCount, FallbackValue=—}" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource BadBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="COMPLETED" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding CompletedTodayCount, FallbackValue=—}" Style="{DynamicResource StatCardValueStyle}" Foreground="{DynamicResource GoodBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6"
                            Background="{DynamicResource SurfaceBrush}" CornerRadius="0"
                            Visibility="{Binding HasActiveDownload, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveDownloadSummary}" FontSize="12"
                                   Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <!-- Opens itself when a multi-stream transfer starts; a manual collapse sticks until it ends. -->
                    <Expander x:Name="StreamsExpander" DockPanel.Dock="Top" Header="Connection streams and throughput" IsExpanded="False" Margin="0,0,0,8"
                              Expanded="StreamsExpander_Toggled" Collapsed="StreamsExpander_Toggled"
                              Visibility="{Binding HasStreamMatrix, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <sm:StreamMatrixView DataContext="{Binding StreamMatrix}" ConfigRequested="StreamMatrix_ConfigRequested"/>
                        </ScrollViewer>
                    </Expander>
                    <!-- Transfer Queue HUD panel wrapping the toolbar + DataGrid -->
                    <Border Style="{DynamicResource HudPanelStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="TRANSFER QUEUE" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>
                            <Grid>
                                <DockPanel>
                                    <!-- Selection actions | clear history | ordering; wraps on narrow windows. -->
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="0" Padding="8,6" Margin="0,0,0,0">
                                        <WrapPanel>
                                            <Button Content="{Binding SelectedDownloadItem.PauseResumeLabel, TargetNullValue=Pause, FallbackValue=Pause}"
                                                    Command="{Binding PauseResumeDownloadCommand}" AutomationProperties.Name="Pause or resume selected download"
                                                    Padding="10,6" Margin="0,0,6,4" Style="{DynamicResource SecondaryButton}"
                                                    IsEnabled="{Binding SelectedDownloadItem.CanPauseOrResume, FallbackValue=False}"/>
                                            <Button Content="Cancel selected" Command="{Binding CancelDownloadCommand}"
                                                    Padding="10,6" Margin="0,0,6,4" Style="{DynamicResource SecondaryButton}"/>
                                            <Button Content="{Binding SelectedDownloadItem.RetryLabel, TargetNullValue=Retry, FallbackValue=Retry}" Command="{Binding RetryDownloadCommand}"
                                                    ToolTip="Retry a failed or cancelled download; review blocked torrent files before choosing to skip them"
                                                    Padding="10,6" Margin="0,0,6,4" Style="{DynamicResource SecondaryButton}" IsEnabled="{Binding SelectedDownloadItem.CanRetry, FallbackValue=False}"/>
                                            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}"
                                                    Padding="12,6" Margin="0,0,0,4" Style="{DynamicResource SecondaryButton}"
                                                    ToolTip="Open download folder in Explorer" IsEnabled="{Binding SelectedItem, ElementName=DownloadsGrid, Converter={StaticResource HasSelectionConverter}}"/>
                                            <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>
                                            <ui:ClearDownloadsMenuButton x:Name="ClearDownloadsMenu"/>
                                            <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>
                                            <Button Content="↑ Up" Command="{Binding MoveUpCommand}" AutomationProperties.Name="Move Up"
                                                    ToolTip="Move the selected download up the queue"
                                                    Padding="12,6" Margin="0,0,6,4" Style="{DynamicResource SecondaryButton}" IsEnabled="{Binding SelectedItem, ElementName=DownloadsGrid, Converter={StaticResource HasSelectionConverter}}"/>
                                            <Button Content="↓ Down" Command="{Binding MoveDownCommand}" AutomationProperties.Name="Move Down"
                                                    ToolTip="Move the selected download down the queue"
                                                    Padding="12,6" Margin="0,0,0,4" Style="{DynamicResource SecondaryButton}" IsEnabled="{Binding SelectedItem, ElementName=DownloadsGrid, Converter={StaticResource HasSelectionConverter}}"/>
                                        </WrapPanel>
                                    </Border>
                                    <Grid>
<ListBox ItemsSource="{Binding DownloadItems}"
                              SelectedItem="{Binding SelectedDownloadItem}"
                              SelectionMode="Extended"
                              AllowDrop="True" Drop="Downloads_Drop"
                              x:Name="DownloadsGrid"
                              SelectionChanged="DownloadsGrid_SelectionChanged"
                              Background="Transparent" BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemContainerStyle="{StaticResource DownloadQueueItemStyle}">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Pause" Command="{Binding PauseDownloadCommand}" IsEnabled="{Binding SelectedDownloadItem.CanPause, FallbackValue=False}"/>
                                <MenuItem Header="Resume" Command="{Binding ResumeDownloadCommand}" IsEnabled="{Binding SelectedDownloadItem.CanResume, FallbackValue=False}"/>
                                <MenuItem Header="Cancel selected" Command="{Binding CancelDownloadCommand}"/>
                                <MenuItem Header="{Binding SelectedDownloadItem.RetryLabel, TargetNullValue=Retry, FallbackValue=Retry}" Command="{Binding RetryDownloadCommand}" IsEnabled="{Binding SelectedDownloadItem.CanRetry, FallbackValue=False}"/>
                                <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}"/>
                                <Separator/>
                                <MenuItem Header="Remove selected terminal history" Command="{Binding RemoveSelectedDownloadsCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedDownloadsCommand}"/>
                            <KeyBinding Key="R" Command="{Binding RetryDownloadCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ui:DownloadRowView/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=DownloadsGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Your download queue is clear" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Choose Download in Search, Notifications, or the Player's torrent results. FTP and BitTorrent transfers appear here." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ===== MEDIA group ===== -->
            <TabItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" Padding="14,3,14,0">
                <TabItem.Header>
                    <TextBlock Text="// MEDIA" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                </TabItem.Header>
            </TabItem>

            <!-- Search Tab -->
            <TabItem AutomationProperties.Name="Search">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="05" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Search" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, ElementName=SearchGrid, StringFormat={}{0} results}"
                                           Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"/>
                                <TextBlock Text="SEARCH" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelSearchCommand}"
                                Padding="12,6" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
                        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                                Padding="18,6" Margin="10,0,0,0" Style="{DynamicResource PrimaryButton}"/>
                        <TextBox x:Name="SearchQueryBox" AutomationProperties.Name="Search connected servers" ToolTip="Enter a release, movie, or show name, then press Enter" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SearchStatus}" Style="{DynamicResource OptionalConsoleTextStyle}" Margin="0,0,0,6"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"/>
                    <!-- Filter chips: FilterChip toggles run ToggleSearchFilterCommand once per click,
                         Space or UIA Toggle; IsChecked follows the view model one-way. Quality and
                         source stay exclusive. ALL is on when no filter is active and clears them. -->
                    <Border DockPanel.Dock="Top" Padding="0,2" Margin="0,0,0,8">
                        <WrapPanel ItemHeight="36">
                            <TextBlock Text="FILTERS" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ui:FilterChip x:Name="AllResultsChip" Style="{StaticResource FilterChipStyle}" Content="ALL" ToggleCommandParameter="clear"
                                           IsChecked="{Binding SearchFilterAnyActive, Mode=OneWay, Converter={StaticResource InverseBoolean}}"
                                           AutomationProperties.Name="All results (clear search filters)"
                                           ToolTip="Show all results; clears every filter"/>
                            <Rectangle Style="{StaticResource ToolbarDividerStyle}" Margin="0,0,6,0"/>
                            <ui:FilterChip Style="{StaticResource FilterChipStyle}" Content="1080p" ToggleCommandParameter="quality:1080p"
                                           IsChecked="{Binding SearchFilterQuality, Mode=OneWay, Converter={StaticResource ValueEquals}, ConverterParameter=1080p}"
                                           AutomationProperties.Name="Filter 1080p"/>
                            <ui:FilterChip Style="{StaticResource FilterChipStyle}" Content="2160p" ToggleCommandParameter="quality:2160p"
                                           IsChecked="{Binding SearchFilterQuality, Mode=OneWay, Converter={StaticResource ValueEquals}, ConverterParameter=2160p}"
                                           AutomationProperties.Name="Filter 2160p"/>
                            <ui:FilterChip Style="{StaticResource FilterChipStyle}" Content="WEB" ToggleCommandParameter="source:WEB"
                                           IsChecked="{Binding SearchFilterSource, Mode=OneWay, Converter={StaticResource ValueEquals}, ConverterParameter=WEB}"
                                           AutomationProperties.Name="Filter WEB"/>
                            <ui:FilterChip Style="{StaticResource FilterChipStyle}" Content="BLURAY" ToggleCommandParameter="source:BLURAY"
                                           IsChecked="{Binding SearchFilterSource, Mode=OneWay, Converter={StaticResource ValueEquals}, ConverterParameter=BLURAY}"
                                           AutomationProperties.Name="Filter Blu-ray"/>
                            <ui:FilterChip Style="{StaticResource FilterChipStyle}" Content="&gt; 1GB" ToggleCommandParameter="size:1GB"
                                           IsChecked="{Binding SearchFilterBigSize, Mode=OneWay}"
                                           AutomationProperties.Name="Filter larger than 1 GB"/>
                        </WrapPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Download Selected" HorizontalAlignment="Left" Command="{Binding DownloadSearchResultCommand}"
                                Padding="16,6" Style="{DynamicResource PrimaryButton}"
                                ToolTip="Download all selected results (Ctrl+click to multi-select)" IsEnabled="{Binding SelectedItem, ElementName=SearchGrid, Converter={StaticResource HasSelectionConverter}}"/>
                    </DockPanel>
                    <Grid>
<DataGrid ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedSearchResult}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              x:Name="SearchGrid"
                              SelectionChanged="SearchGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                              MouseMove="DragSource_MouseMove">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Download Selected" Command="{Binding DownloadSearchResultCommand}" FontWeight="Bold"/>
                                <MenuItem Header="Copy Release Name" Command="{Binding CopySearchResultCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding DownloadSearchResultCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <!-- Coloured scene tokens; copy, sort and tooltip still use the exact ReleaseName. -->
                            <DataGridTemplateColumn Header="Release" Width="*" SortMemberPath="ReleaseName"
                                                    ClipboardContentBinding="{Binding ReleaseName}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ui:ReleaseNameText.Source="{Binding ReleaseName}" ToolTip="{Binding ReleaseName}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SearchGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No results to show" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Search by release, movie, or show name. Try fewer keywords or clear the filters to broaden your results." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Player Tab -->
            <TabItem AutomationProperties.Name="Player">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="06" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Player" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Grid x:Name="PlayerTab" DataContext="{Binding Player}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" MaxWidth="420"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left sidebar -->
                    <DockPanel Grid.Column="0">
                        <!-- Search bar (always visible) -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                                Padding="6,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Search"
                                        Command="{Binding SearchCommand}"
                                        Padding="7,4" Margin="4,0,0,0" Style="{DynamicResource PrimaryButton}" FontSize="12"/>
                                <TextBox x:Name="PlayerSearchBox" AutomationProperties.Name="Search movies and TV shows" ToolTip="Search movies and TV shows" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" FontSize="11.5" VerticalContentAlignment="Center"
                                         Background="{DynamicResource SurfaceLightBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"/>
                            </DockPanel>
                        </Border>

                        <!-- Mode tabs: Browse | Now Playing | Library -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                <RadioButton x:Name="BrowseMode" Content="Browse" IsChecked="True"
                                             Style="{StaticResource ModeTabStyle}"
                                             Padding="12,5" Margin="0,0,4,0" FontSize="12"/>
                                <RadioButton x:Name="NowPlayingMode" Content="Now Playing"
                                             Style="{StaticResource ModeTabStyle}"
                                             Padding="12,5" Margin="0,0,4,0" FontSize="12"/>
                                <RadioButton x:Name="LibraryMode" Content="Library"
                                             Style="{StaticResource ModeTabStyle}"
                                             Padding="12,5" FontSize="12"
                                             Checked="LibraryMode_Checked"/>
                            </StackPanel>
                        </Border>

                        <!-- Status bar -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                                Padding="8,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding PlayerStatus}"
                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- ═══ BROWSE MODE ═══ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=BrowseMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="8,6,8,6">

                                <!-- Search results (only when search has results) -->
                                <StackPanel Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="Clear" FontSize="12"
                                                Command="{Binding ClearSearchCommand}"
                                                Style="{DynamicResource SecondaryButton}" Padding="8,2"/>
                                        <TextBlock Text="Search Results" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,5,5" Cursor="Hand"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        CornerRadius="4" ClipToBounds="True"
                                                        MouseLeftButtonDown="SearchCard_Click">
                                                    <StackPanel>
                                                        <Border Height="135" ClipToBounds="True" CornerRadius="4,4,0,0">
                                                            <Image Source="{Binding PosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=95}"
                                                                   Stretch="UniformToFill" VerticalAlignment="Top"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <StackPanel Margin="3,2,3,3">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="9.5"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxHeight="24"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBlock Text="{Binding RatingDisplay}" FontSize="12"
                                                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Year}" FontSize="12" Margin="4,0,0,0"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator Margin="0,4,0,6" Background="{DynamicResource BorderBrush}"/>
                                </StackPanel>

                                <!-- Trending Movies -->
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="&#x21BB;" FontSize="12"
                                            Command="{Binding RefreshTrendingCommand}"
                                            Style="{DynamicResource SecondaryButton}" Padding="6,2"
                                            ToolTip="Refresh trending"/>
                                    <TextBlock Text="&#x1F3AC; Trending Movies" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding TrendingMovies}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,5,5" Cursor="Hand"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="4" ClipToBounds="True"
                                                    MouseLeftButtonDown="MovieCard_Click">
                                                <StackPanel>
                                                    <Border Height="135" ClipToBounds="True" CornerRadius="4,4,0,0">
                                                        <Image Source="{Binding PosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=95}"
                                                               Stretch="UniformToFill" VerticalAlignment="Top"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <StackPanel Margin="3,2,3,3">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="9.5"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="24"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding RatingDisplay}" FontSize="12"
                                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Year}" FontSize="12" Margin="4,0,0,0"
                                                                       Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Trending TV -->
                                <TextBlock Text="&#x1F4FA; Trending TV" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,4"/>
                                <ItemsControl ItemsSource="{Binding TrendingTvShows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,5,5" Cursor="Hand"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="4" ClipToBounds="True"
                                                    MouseLeftButtonDown="TvCard_Click">
                                                <StackPanel>
                                                    <Border Height="135" ClipToBounds="True" CornerRadius="4,4,0,0">
                                                        <Image Source="{Binding PosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=95}"
                                                               Stretch="UniformToFill" VerticalAlignment="Top"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <StackPanel Margin="3,2,3,3">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="9.5"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="24"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding RatingDisplay}" FontSize="12"
                                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Year}" FontSize="12" Margin="4,0,0,0"
                                                                       Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══ NOW PLAYING MODE (detail + episodes + FTP results) ═══ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=NowPlayingMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="8,6,8,6">
                                <!-- Selected media detail -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="10" Margin="0,0,0,6"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="90" Margin="0,0,10,0"
                                                    CornerRadius="4" ClipToBounds="True"
                                                    Background="{DynamicResource SurfaceLightBrush}"
                                                    Visibility="{Binding HasDetailPoster, Converter={StaticResource BoolToVisibility}}">
                                                <Image Stretch="UniformToFill" VerticalAlignment="Top"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding DetailPosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=90}"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DetailTitle}" FontWeight="Bold" FontSize="15"
                                                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" MaxHeight="40"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding DetailRating}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding DetailYear}" FontSize="12" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailGenres}" FontSize="10.5" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                <TextBlock Text="{Binding DetailPlot}" TextWrapping="Wrap"
                                                           MaxHeight="48" FontSize="12" Margin="0,5,0,0"
                                                           LineHeight="15"
                                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Content="&#x1F50D; Search" Margin="0,8,0,0"
                                                        Command="{Binding SearchAndPlayCommand}"
                                                        Padding="14,6" Style="{DynamicResource PrimaryButton}"
                                                        HorizontalAlignment="Left" FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- FTP Search Results -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="10"
                                        Visibility="{Binding HasFtpResults, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="FTP Results" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                                        <DataGrid ItemsSource="{Binding FtpResults}"
                                                  SelectedItem="{Binding SelectedFtpResult}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column" CanUserAddRows="False"
                                                  MaxHeight="160"
                                                  MouseDoubleClick="PlayerResult_DoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Release" Binding="{Binding ReleaseName}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                                <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="60"/>
                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="55"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Content="&#x25B6; Play Selected" Command="{Binding PlayResultCommand}"
                                                Padding="14,5" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                Style="{DynamicResource PrimaryButton}" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Torrent Results -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="10" Margin="0,6,0,0"
                                        Visibility="{Binding HasTorrentResults, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Torrent Results" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                                        <DataGrid ItemsSource="{Binding TorrentResults}"
                                                  SelectedItem="{Binding SelectedTorrentResult}"
                                                  AutoGenerateColumns="False" IsReadOnly="True"
                                                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column" CanUserAddRows="False"
                                                  MaxHeight="160"
                                                  MouseDoubleClick="TorrentResult_DoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                                <DataGridTextColumn Header="S" Binding="{Binding SeedsDisplay}" Width="35">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="L" Binding="{Binding LeechesDisplay}" Width="35">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="65"/>
                                                <DataGridTextColumn Header="Source" Binding="{Binding Uploader}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="&#x25B6; Play Torrent" Command="{Binding PlayTorrentCommand}"
                                                    Padding="14,5" HorizontalAlignment="Left"
                                                    Style="{DynamicResource PrimaryButton}" FontSize="12"/>
                                            <Button Content="&#x2B07; Queue download&#x2026;"
                                                    Command="{Binding DownloadTorrentCommand}"
                                                    Padding="14,5" Margin="8,0,0,0" HorizontalAlignment="Left"
                                                    FontSize="12"
                                                    ToolTip="Choose a folder and add this torrent's content to the main Downloads queue. Stops once complete."/>
                                        </StackPanel>

                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Torrent downloads continue in Downloads when the Player closes."
                                                       Style="{DynamicResource MicroTextStyle}" TextWrapping="Wrap"/>
                                            <Button Content="Open Downloads" Command="{Binding ShowDownloadsCommand}"
                                                    Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"
                                                    Padding="10,5" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Empty state hint -->
                                <Border Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,30,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No selection" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Click a movie or TV show in Browse to see details."
                                                   FontSize="12" Foreground="{DynamicResource ForegroundDimBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="250"/>
                                    </StackPanel>
                                </Border>

                                <!-- TV Episode Picker -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="10" Margin="0,0,0,6"
                                        Visibility="{Binding ShowEpisodePicker, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Episodes" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Seasons}"
                                                      SelectedItem="{Binding SelectedSeason}"
                                                      DisplayMemberPath="Name" Width="150" FontSize="12"
                                                      HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Episodes}" MaxHeight="200">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="3"
                                                            Padding="8,5" Margin="0,0,0,2" Cursor="Hand"
                                                            MouseLeftButtonDown="Episode_Click">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Runtime, StringFormat={}{0}m}"
                                                                       FontSize="12" Foreground="{DynamicResource ForegroundDimBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══ LIBRARY MODE ═══ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsChecked, ElementName=LibraryMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="8,6,8,6">
                                <TextBlock Text="&#x1F4BF; Downloaded Library" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding LibraryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="0"
                                                    Padding="10,7" Margin="0,0,0,4" Cursor="Hand"
                                                    MouseLeftButtonDown="LibraryItem_Click">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding ResumePercent}" FontSize="12"
                                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ReleaseName}" FontWeight="SemiBold" FontSize="12"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="12" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="Transparent"/>

                    <!-- Right: Video Player + Controls -->
                    <DockPanel Grid.Column="2">
                        <!-- Transport controls -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="8,5">
                            <StackPanel>
                                <Slider Value="{Binding Position, Mode=OneWay}" Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                        Margin="0,0,0,3"
                                        x:Name="PlayerSeekBar"
                                        Thumb.DragCompleted="SeekBar_DragCompleted" PreviewMouseLeftButtonUp="SeekBar_MouseUp"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#x25B6;&#xFE0E;" Command="{Binding PlayPauseCommand}"
                                                Padding="6,3" Margin="0,0,4,0" Style="{DynamicResource PrimaryButton}"
                                                FontSize="13" Width="32" ToolTip="Play / Pause (Space)"/>
                                        <Button Content="&#x25A0;" Command="{Binding StopCommand}"
                                                Padding="6,3" Margin="0,0,8,0" Style="{DynamicResource SecondaryButton}"
                                                FontSize="12" Width="32" ToolTip="Stop"/>
                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding AudioTracks}"
                                                  SelectedIndex="{Binding AudioTrackIndex}"
                                                  Width="75" FontSize="12" Margin="0,0,4,0"
                                                  ToolTip="Audio track"/>
                                        <ComboBox ItemsSource="{Binding SubtitleTracks}"
                                                  SelectedIndex="{Binding SubtitleTrackIndex}"
                                                  Width="75" FontSize="12" Margin="0,0,6,0"
                                                  ToolTip="Subtitle track"/>
                                        <!-- Cast button -->
                                        <Button x:Name="CastButton" Content="&#x1F4E1;&#xFE0E;" FontSize="12"
                                                Padding="4,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Style="{DynamicResource SecondaryButton}"
                                                Click="CastButton_Click">
                                            <Button.ToolTip>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="CastButtonTooltip"/>
                                                </MultiBinding>
                                            </Button.ToolTip>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <ContextMenu.Resources>
                                                        <Style x:Key="RendererItem" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                            <Setter Property="Command"
                                                                    Value="{Binding DataContext.CastToDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                        </Style>
                                                    </ContextMenu.Resources>
                                                    <MenuItem Header="Cast to" ItemsSource="{Binding Renderers}"
                                                              ItemContainerStyle="{StaticResource RendererItem}"
                                                              Visibility="{Binding HasRenderers, Converter={StaticResource BoolToVisibility}}"/>
                                                    <MenuItem Header="No devices found" IsEnabled="False"
                                                              Visibility="{Binding HasNoRenderers, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Separator Visibility="{Binding IsCasting, Converter={StaticResource BoolToVisibility}}"/>
                                                    <MenuItem Header="Stop casting" Command="{Binding StopCastingCommand}"
                                                              Visibility="{Binding IsCasting, Converter={StaticResource BoolToVisibility}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <TextBlock Text="&#x1F50A;" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="12"/>
                                        <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="70" MinWidth="50"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Video area -->
                        <Grid Background="Black" x:Name="PlayerVideoArea" MouseLeftButtonDown="VideoArea_MouseDown">
                            <!-- NO SIGNAL overlay (rendered behind VideoView; visible when video is idle) -->
                            <Grid IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                                    <TextBlock Text="Choose something to watch" FontFamily="{DynamicResource DisplayFontFamily}" FontWeight="Bold"
                                               FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                                    </TextBlock>
                                    <TextBlock Text="Search for a title or open your library to begin." Style="{DynamicResource MicroTextStyle}"
                                               FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                            <vlc:VideoView x:Name="PlayerVideoView"/>
                            <!-- Buffering overlay -->
                            <Border Background="#CC000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x23F3; Buffering..." FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <ProgressBar Value="{Binding BufferProgress}" Maximum="100"
                                                 Width="200" Height="6" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding PlayerStatus}" FontSize="12"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Upcoming Tab -->
            <TabItem AutomationProperties.Name="Upcoming">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="07" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Upcoming" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                            <TextBlock Text="UPCOMING RELEASES" Style="{DynamicResource SectionHeaderTextStyle}"/>
                        </Border>
                        <Grid>
                            <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="0" Padding="8,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding LoadUpcomingCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}"/>
                            <Button Content="Add to Wishlist" Command="{Binding AddUpcomingToWishlistCommand}"
                                    Padding="12,6" Margin="0,0,12,0" Style="{DynamicResource PrimaryButton}"/>
                            <Button Content="Release dates" Command="{Binding RefreshUpcomingCalendarCommand}"
                                    Padding="12,6" Margin="0,0,12,0" Style="{DynamicResource SecondaryButton}" ToolTip="Look up dates for the selected movie"/>
                            <TextBlock Text="Quality:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding QualityOptions}"
                                      SelectedItem="{Binding UpcomingQualityText}" Width="90"/>
                            <TextBlock Text="{Binding UpcomingStatus}" VerticalAlignment="Center"
                                       Margin="16,0,0,0" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Height="155"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Margin="0,10,0,0" Padding="14"
                            Visibility="{Binding HasUpcomingSelection, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="95" Margin="0,0,16,0"
                                    CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceLightBrush}"
                                    Visibility="{Binding HasUpcomingPoster, Converter={StaticResource BoolToVisibility}}">
                                <Image Stretch="UniformToFill" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding UpcomingPosterUrl, Converter={StaticResource ImageUrlConverter}, ConverterParameter=120}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="{Binding UpcomingDetailTitle}" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding UpcomingRating}" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding UpcomingGenres}" FontSize="12.5"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               Margin="14,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UpcomingPlot}" TextWrapping="Wrap"
                                           MaxHeight="65" FontSize="12.5" Margin="0,8,0,0"
                                           LineHeight="18"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding TvScheduleHeader}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox ItemsSource="{Binding TvTypeOptions}"
                                              SelectedItem="{Binding TvTypeFilter}"
                                              Width="90" FontSize="12" Margin="0,0,6,0"
                                              ToolTip="Filter by show type"/>
                                    <TextBox Text="{Binding ShowSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Search TV schedule by show"
                                             Width="140" VerticalContentAlignment="Center" FontSize="11.5"
                                             Margin="0,0,4,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchShowScheduleCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="Search" Command="{Binding SearchShowScheduleCommand}"
                                            Padding="8,3" FontSize="12" Style="{DynamicResource PrimaryButton}"/>
                                    <Button Content="X" Command="{Binding ClearShowSearchCommand}"
                                            Padding="6,3" Margin="4,0,0,0" FontSize="12"
                                            Style="{DynamicResource SecondaryButton}"
                                            Visibility="{Binding IsShowSearchActive, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding UpcomingTvEpisodes}"
                                      SelectedItem="{Binding SelectedTvEpisode}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="75"/>
                                    <DataGridTextColumn Header="Show" Binding="{Binding ShowName}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                    <DataGridTextColumn Header="Network" Binding="{Binding NetworkDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="Episode" Binding="{Binding EpisodeInfo}" Width="140"/>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="Transparent"/>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6">
                                <Run Text="Movie Releases"/>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       Visibility="{Binding HasNoTmdbKey, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Configure TMDb API key in Settings &#x2192; Downloads to see movie releases."/>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding UpcomingMovies}"
                                      SelectedItem="{Binding SelectedUpcomingMovie}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="50"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding ReleaseDateDisplay}" Width="85"/>
                                    <DataGridTextColumn Header="Theatrical" Binding="{Binding TheatricalDate}" Width="95"/>
                                    <DataGridTextColumn Header="Digital" Binding="{Binding DigitalDate}" Width="95"/>
                                    <DataGridTextColumn Header="Physical" Binding="{Binding PhysicalDate}" Width="95"/>
                                    <DataGridTextColumn Header="Genres" Binding="{Binding Genres}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Plex Tab -->
            <TabItem AutomationProperties.Name="Plex">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="08" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Plex" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <DockPanel Margin="12" DataContext="{Binding Plex}">
                    <Border Style="{DynamicResource HudPanelStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="PLEX INVITE MANAGER" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>

                            <!-- Toolbar: connection + server picker -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="8,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Login to Plex" Command="{Binding LoginCommand}"
                                            Padding="14,4" Margin="6,0,0,0" Style="{DynamicResource PrimaryButton}"
                                            Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button DockPanel.Dock="Right" Content="Logout" Command="{Binding LogoutCommand}"
                                            Padding="10,4" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"
                                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestConnectionCommand}"
                                            Padding="10,4" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"
                                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                                            Padding="10,4" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"
                                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                                    <ComboBox DockPanel.Dock="Right" Width="200" Margin="6,0,0,0"
                                              ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                              DisplayMemberPath="Name"
                                              Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button DockPanel.Dock="Right" Content="Load Servers" Command="{Binding RefreshServersCommand}"
                                            Padding="10,4" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"
                                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button DockPanel.Dock="Right" Content="Use" Command="{Binding SelectServerCommand}"
                                            CommandParameter="{Binding SelectedServer}"
                                            Padding="10,4" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"
                                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Grid>
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Invite panel -->
                                    <Border Grid.Column="0" Margin="0,0,6,0" Style="{DynamicResource HudPanelStyle}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                                <TextBlock Text="INVITE USER" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                            </Border>
                                            <StackPanel DockPanel.Dock="Top" Margin="8">
                                                <TextBlock Text="Plex username or email" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundDimBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding InviteTarget, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Plex username or email"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                                <CheckBox Content="Allow downloads / sync" IsChecked="{Binding AllowDownloads}"
                                                          Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                                                <TextBlock Text="Libraries (none = all)" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundDimBrush}" Margin="0,0,0,2"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Bottom" Content="Send Invite" Command="{Binding InviteCommand}"
                                                    IsEnabled="{Binding IsNotBusy}" Margin="8" Padding="0,8"
                                                    Style="{DynamicResource PrimaryButton}"/>
                                            <Border Margin="8,0,8,8" Style="{DynamicResource HudPanelStyle}">
                                                <ListBox ItemsSource="{Binding Libraries}" Background="Transparent" BorderThickness="0">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                                      Foreground="{DynamicResource ForegroundBrush}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Title}"/>
                                                                    <TextBlock Text="{Binding Type}" Margin="6,0,0,0"
                                                                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <!-- Current access -->
                                    <Border Grid.Column="1" Style="{DynamicResource HudPanelStyle}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                                <TextBlock Text="CURRENT ACCESS" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                            </Border>
                                            <DataGrid ItemsSource="{Binding SharedUsers}" SelectedItem="{Binding SelectedSharedUser}"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      Background="Transparent" BorderThickness="0" Margin="6"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="140"/>
                                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                                    <DataGridTextColumn Header="Libraries" Binding="{Binding LibrariesDisplay}" Width="*"/>
                                                    <DataGridTextColumn Header="Sync" Binding="{Binding DownloadsDisplay}" Width="50"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="70"/>
                                                    <DataGridTemplateColumn Header="" Width="80">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Revoke" Padding="8,2" FontSize="12"
                                                                        Style="{DynamicResource SecondaryButton}"
                                                                        Command="{Binding DataContext.Plex.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ===== COMMS group ===== -->
            <TabItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" Padding="14,3,14,0">
                <TabItem.Header>
                    <TextBlock Text="// COMMS" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                </TabItem.Header>
            </TabItem>

            <!-- IRC Tab -->
            <TabItem AutomationProperties.Name="IRC">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="09" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="IRC" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Irc.UnreadDisplay}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <DockPanel Margin="12">
                    <!-- Outer IRC HUD panel -->
                    <Border Style="{DynamicResource HudPanelStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="IRC" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>
                            <Grid>
                                <DockPanel Margin="6">
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="8,4" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Reconnect" Command="{Binding Irc.ReconnectCommand}"
                                                    Padding="10,2" Margin="4,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"/>
                                            <Button DockPanel.Dock="Right" Content="Disconnect" Command="{Binding Irc.DisconnectCommand}"
                                                    Padding="10,2" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"/>
                                            <Button DockPanel.Dock="Right" Content="Search logs" Click="IrcSearch_Click"
                                                    Padding="10,2" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"/>
                                            <Button DockPanel.Dock="Right" Content="Mark read" Click="IrcMarkRead_Click"
                                                    Padding="10,2" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" FontSize="12"/>
                                            <TextBlock Text="{Binding Irc.TopicText}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                Padding="8,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Send" Command="{Binding Irc.SendCommand}"
                                                        Padding="16,6" Margin="6,0,0,0" Style="{DynamicResource PrimaryButton}"/>
                                                <TextBox AutomationProperties.Name="IRC message" ToolTip="Message the selected channel. Enter sends; Tab completes a nickname." Text="{Binding Irc.InputText, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" x:Name="IrcInputBox">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding Irc.SendCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Channels inner panel -->
                                        <Border Grid.Column="0" Margin="0,0,6,0" Style="{DynamicResource HudPanelStyle}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                                    <TextBlock Text="CHANNELS" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                                </Border>
                                                <Grid>
                                                    <ListBox ItemsSource="{Binding Irc.Channels}"
                                                             SelectedItem="{Binding Irc.SelectedChannel}"
                                                             Background="Transparent" BorderThickness="0">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#x1F512;" FontSize="12" Margin="0,0,4,0"
                                                                               Visibility="{Binding HasFishKey, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <TextBlock Text="{Binding SidebarDisplay}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding UnreadDisplay}" Foreground="{DynamicResource AccentBrush}"
                                                                               FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding HighlightDisplay}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <!-- Messages inner panel -->
                                        <Border Grid.Column="1" Margin="0,0,6,0" Style="{DynamicResource HudPanelStyle}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                                    <TextBlock Text="MESSAGES" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                                </Border>
                                                <Grid>
                                                    <ListBox ItemsSource="{Binding Irc.Messages}"
                                                             x:Name="IrcMessageList" HorizontalContentAlignment="Stretch"
                                                             Background="Transparent" BorderThickness="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             VirtualizingPanel.ScrollUnit="Pixel">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="4,3" LastChildFill="True">
                                                                    <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource ForegroundDimBrush}"
                                                                               FontSize="12" Margin="0,0,6,0" FontFamily="Consolas"/>
                                                                    <TextBlock Text="&#x1F512;" FontSize="12" Margin="0,0,3,0"
                                                                               Visibility="{Binding WasEncrypted, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <TextBlock ui:ReleaseTextHelper.Message="{Binding}"
                                                                               ui:ReleaseTextHelper.ClickCommand="{Binding DataContext.Irc.ReleaseLinkClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               TextWrapping="Wrap"
                                                                               FontFamily="Consolas" FontSize="12.5">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{Binding NickColor}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsSystemMessage}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}"/>
                                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <!-- Users inner panel -->
                                        <Border Grid.Column="2" Style="{DynamicResource HudPanelStyle}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                                    <TextBlock Text="USERS" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                                </Border>
                                                <Grid>
                                                    <ListBox ItemsSource="{Binding Irc.NickList}" x:Name="IrcNickList"
                                                             Background="Transparent" BorderThickness="0" FontSize="12">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Per-item context menu: {Binding} resolves to the
                                                                     actual right-clicked nick (a string), not the
                                                                     ListBox.SelectedItem which may be stale or null
                                                                     because WPF doesn't auto-select on right-click.
                                                                     Find ancestor Window via DataContext to reach
                                                                     the DashboardViewModel.Irc.* commands. -->
                                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource ForegroundBrush}">
                                                                    <TextBlock.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Private Message"
                                                                                      Command="{Binding PlacementTarget.Tag.DataContext.Irc.PrivateMessageNickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}"/>
                                                                            <MenuItem Header="FiSH Key Exchange"
                                                                                      Command="{Binding PlacementTarget.Tag.DataContext.Irc.KeyExchangeNickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}"/>
                                                                        </ContextMenu>
                                                                    </TextBlock.ContextMenu>
                                                                    <!-- Tag chains the per-item TextBlock to the
                                                                         hosting Window so the ContextMenu can reach
                                                                         the DataContext via PlacementTarget.Tag. -->
                                                                    <TextBlock.Tag>
                                                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </TextBlock.Tag>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- PreDB Tab -->
            <TabItem AutomationProperties.Name="PreDB">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="10" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="PreDB" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                            <TextBlock Text="PREDB" Style="{DynamicResource SectionHeaderTextStyle}"/>
                        </Border>
                        <Grid>
                            <DockPanel Margin="12">
                    <!-- Search bar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelPreDbSearchCommand}"
                                Padding="12,6" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}"
                                Visibility="{Binding IsPreDbSearching, Converter={StaticResource BoolToVisibility}}"/>
                        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchPreDbCommand}"
                                Padding="18,6" Margin="6,0,0,0" Style="{DynamicResource PrimaryButton}"/>
                        <ComboBox DockPanel.Dock="Right" Width="90" Margin="6,0,0,0"
                                  ItemsSource="{Binding PreDbSectionFilters}"
                                  SelectedItem="{Binding PreDbSectionFilter}"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource ForegroundBrush}" FontSize="12"/>
                        <TextBox AutomationProperties.Name="Search release database" ToolTip="Search release names in PreDB" Text="{Binding PreDbQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchPreDbCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <!-- Status + progress -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{Binding PreDbStatus}" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12"/>
                        <ProgressBar Value="{Binding PreDbRefreshProgress}" Minimum="0" Maximum="100"
                                     Height="3" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SurfaceBrush}"/>
                    </DockPanel>
                    <!-- Results grid -->
                    <Grid>
<DataGrid x:Name="PreDbGrid" ItemsSource="{Binding PreDbItems}" SelectedItem="{Binding SelectedPreDbItem}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Search on Servers" Command="{Binding SearchPreDbOnServersCommand}" FontWeight="Bold"/>
                                <MenuItem Header="Race / Spread" Command="{Binding RacePreDbCommand}"/>
                                <Separator/>
                                <MenuItem Header="Copy Release Name" Command="{Binding CopyPreDbReleaseCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNuked}" Value="True">
                                        <Setter Property="Foreground" Value="#F44336"/>
                                        <Setter Property="ToolTip" Value="{Binding NukeReason, StringFormat='NUKED: {0}'}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Release" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNuked}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Group" Binding="{Binding Team}" Width="90"/>
                            <DataGridTextColumn Header="Section" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="45"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=PreDbGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No releases to show" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Search the release database above. Search status and any connection errors appear above this list." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== TRANSFERS group ===== -->
            <TabItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" Padding="14,3,14,0">
                <TabItem.Header>
                    <TextBlock Text="// TRANSFERS" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                </TabItem.Header>
            </TabItem>

            <!-- Spread Tab -->
            <TabItem x:Name="SpreadTab" AutomationProperties.Name="Spread">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="11" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Spread" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Grid Margin="12">
                    <!-- Setup Guide (shown when no sections configured) -->
                    <Border Visibility="{Binding NeedSetup, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                            Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="600">
                        <StackPanel>
                            <TextBlock Text="Spread / FXP Setup" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,16"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="0,0,0,12"
                                       Text="The Spread engine lets you race and FXP releases between your connected servers. To get started:"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,4"
                                       Text="1. Go to Settings > Servers tab and click Edit on each server you want to use."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,4"
                                       Text="2. Scroll to the 'Spread / FXP' section at the bottom of the server edit dialog."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,4"
                                       Text="3. Add sections as Name=Path (e.g. MP3=/site/mp3, 0DAY=/site/0day), one per line."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,4"
                                       Text="4. Set the priority (Normal/High/VeryHigh), max upload/download slots, and optionally skiplist rules."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,4"
                                       Text="5. Repeat for each server. At least 2 servers must share the same section name to race."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,4"
                                       Text="6. (Optional) In Settings > Spread tab, adjust pool size, timeouts, and global skiplist rules."/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="13" Margin="12,0,0,16"
                                       Text="7. Come back here, pick a section, type a release name, and click New Race."/>
                            <Button Content="Open Settings" Command="{Binding OpenSettingsCommand}"
                                    Padding="16,8" HorizontalAlignment="Left" Style="{DynamicResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                    <!-- Main spread UI (shown when sections exist) -->
                    <Border Visibility="{Binding HasSections, Converter={StaticResource BoolToVisibility}}"
                            Style="{DynamicResource HudPanelStyle}" BorderThickness="0" Background="Transparent">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="SPREAD ENGINE" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>
                            <Grid>
                                <DockPanel Focusable="True">
                    <DockPanel.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding StopJobCommand}"/>
                        <KeyBinding Gesture="Ctrl+R" Command="{Binding StartRaceCommand}"/>
                    </DockPanel.InputBindings>
                    <!-- Stats cards row -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="ACTIVE RACES" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding ActiveRaceCount, FallbackValue=0}" Style="{DynamicResource StatCardValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="LEADER" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding LeaderScore, FallbackValue=—, StringFormat=N0}" Style="{DynamicResource StatCardValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="ACTIVE + QUEUED" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding QueueDepth, FallbackValue=0}" Style="{DynamicResource StatCardValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource StatCardStyle}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <TextBlock Text="HISTORY" Style="{DynamicResource StatCardLabelStyle}"/>
                                        <TextBlock Text="{Binding RaceHistory.Count, FallbackValue=0}" Style="{DynamicResource StatCardValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="0" Padding="8,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding SpreadSections}"
                                      SelectedItem="{Binding SelectedSection}" AutomationProperties.Name="Race section"
                                      Margin="0,0,6,0" ToolTip="Section"/>
                            <TextBox Grid.Column="1" Text="{Binding SpreadReleaseName, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="180" VerticalContentAlignment="Center" AutomationProperties.Name="Release name to race"
                                     ToolTip="Release name" Margin="0,0,6,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding StartRaceCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="New Race" Command="{Binding StartRaceCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource PrimaryButton}"/>
                            <Button Grid.Column="3" Content="Stop" Command="{Binding StopJobCommand}"
                                    Padding="12,6" Margin="0,0,6,0" Style="{DynamicResource SecondaryButton}"/>
                            <Button Grid.Column="4" Content="Settings" Command="{Binding OpenSettingsCommand}"
                                    Padding="12,6" Style="{DynamicResource SecondaryButton}"/>
                        </Grid>
                    </Border>
                    <!-- Status -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SpreadStatus}" Style="{DynamicResource OptionalConsoleTextStyle}" FontSize="12"
                               Foreground="{DynamicResource ForegroundDimBrush}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>
                    <!-- PRD R1/O3 — session success rate + failure taxonomy -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SessionSummary}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{DynamicResource MonoFontFamily}" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
                    <!-- PRD O2 — per-server spread-pool health -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PoolHealth}" Style="{DynamicResource OptionalConsoleTextStyle}" FontSize="12"
                               Foreground="{DynamicResource TextFaintBrush}"
                               FontFamily="{DynamicResource MonoFontFamily}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>
                    <!-- Active races fill the workspace; detailed site activity expands on demand. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- AUTO RACES panel -->
                        <Border Grid.Row="0" Style="{DynamicResource HudPanelStyle}" Margin="0,0,0,10">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                    <DockPanel LastChildFill="True">
                                        <!-- Removes all retained finished (DONE/FAILED/STOPPED) race cards -->
                                        <Button DockPanel.Dock="Right" Content="CLEAR DONE" Padding="8,2" Margin="8,0,0,0"
                                                FontSize="12" VerticalAlignment="Center"
                                                Command="{Binding ClearFinishedCommand}"
                                                ToolTip="Remove all finished race cards from the list"/>
                                        <TextBlock Text="AUTO RACES" Style="{DynamicResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                                        <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Queued race site:" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource ForegroundDimBrush}"/>
                                            <ComboBox ItemsSource="{Binding RaceSiteOptions}" SelectedItem="{Binding SelectedQueuedSite}"
                                                      DisplayMemberPath="Name" MinWidth="150" AutomationProperties.Name="Site for queued race controls"/>
                                            <Button Content="Add site to selected" Command="{Binding AddSelectedQueuedSitesCommand}" Margin="8,0,0,0" Padding="8,4" Style="{DynamicResource SecondaryButton}"/>
                                            <Button Content="Remove site from selected" Command="{Binding RemoveSelectedQueuedSitesCommand}" Margin="8,0,0,0" Padding="8,4" Style="{DynamicResource SecondaryButton}"/>
                                            <Button Content="Remove selected requests" Command="{Binding RemoveSelectedQueuedRacesCommand}" Margin="8,0,0,0" Padding="8,4" Style="{DynamicResource SecondaryButton}"/>
                                        </StackPanel>
                                        <ListBox x:Name="QueuedRacesList" ItemsSource="{Binding QueuedRaces}" SelectionMode="Extended"
                                                 SelectionChanged="QueuedRacesList_SelectionChanged" HorizontalContentAlignment="Stretch"
                                                 Background="{DynamicResource SurfaceBrush}" BorderThickness="0" AutomationProperties.Name="Queued race requests">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Padding="14,10"
                                                            Background="{DynamicResource SurfaceBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Cancel" Margin="12,0,0,0"
                                                                    VerticalAlignment="Center" Padding="8,4"
                                                                    Command="{Binding DataContext.CancelQueuedRaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ReleaseName}" FontSize="12"
                                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ReleaseName}"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                                                                <TextBlock Text="{Binding Sites}" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <WrapPanel Margin="0,6,0,4">
                                                                    <Button Content="Add selected site" Padding="8,4" Margin="0,0,6,0"
                                                                            Command="{Binding DataContext.AddQueuedSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="Remove selected site" Padding="8,4" Margin="0,0,6,0"
                                                                            Command="{Binding DataContext.RemoveQueuedSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="Clean up own partial" Padding="8,4"
                                                                            Command="{Binding DataContext.CleanupOwnedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </WrapPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Section}" FontSize="12"
                                                                               Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,12,0"/>
                                                                    <TextBlock Text="{Binding RetryText}" FontSize="12"
                                                                               Foreground="{DynamicResource TextFaintBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <ListBox ItemsSource="{Binding SpreadJobs}" SelectedItem="{Binding SelectedSpreadJob, Mode=TwoWay}"
                                                 AutomationProperties.Name="Race cards" Background="{DynamicResource SurfaceBrush}"
                                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}"
                                                            BorderThickness="1"
                                                            Padding="12,10">
                                                        <!-- Finished cards stay in the list, dimmed, showing their final score -->
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.72"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Big score on the left -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Score, FallbackValue=0, StringFormat=N0}"
                                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                                           FontWeight="SemiBold" FontSize="26"
                                                                           Foreground="{DynamicResource AccentBrush}">
                                                                </TextBlock>
                                                                <TextBlock Text="SCORE" ToolTip="{Binding ScoreLabel, FallbackValue=AUTO RACE}"
                                                                           Style="{DynamicResource MicroTextStyle}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <!-- Center: release + section/files + source/dest + chips -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
                                                                <TextBlock ui:ReleaseNameText.Source="{Binding Release}" Style="{DynamicResource DisplayTextStyle}" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Release}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding Section}" Style="{DynamicResource MicroTextStyle}"/>
                                                                    <TextBlock Text=" · " Foreground="{DynamicResource TextFaintBrush}"/>
                                                                    <TextBlock Text="{Binding FilesDoneTotalDisplay, FallbackValue=0 / 0}" Style="{DynamicResource MicroTextStyle}"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding SourceDisplay, FallbackValue=—}" Style="{DynamicResource AccentTextStyle}" FontSize="12"/>
                                                                    <TextBlock Text=" → " Foreground="{DynamicResource TextDimBrush}" Margin="6,0"/>
                                                                    <TextBlock Text="{Binding DestDisplay, FallbackValue=—}" Style="{DynamicResource AccentTextStyle}" FontSize="12" Foreground="{DynamicResource Signature2Brush}"/>
                                                                </StackPanel>
                                                                <!-- Tag chips row -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                    <Border Style="{DynamicResource TagAccentStyle}" Margin="0,0,6,0"
                                                                            Visibility="{Binding IsAutoRace, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                                        <TextBlock Text="AUTO" Style="{DynamicResource TagTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                                                    </Border>
                                                                    <Border Style="{DynamicResource TagAccentStyle}" Margin="0,0,6,0"
                                                                            Visibility="{Binding IsPred, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                                        <TextBlock Text="PRED" Style="{DynamicResource TagTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                                                    </Border>
                                                                    <Border Style="{DynamicResource TagWarnStyle}" Margin="0,0,6,0"
                                                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                                        <TextBlock Text="PAUSED" Style="{DynamicResource TagTextStyle}" Foreground="{DynamicResource WarnBrush}"/>
                                                                    </Border>
                                                                    <Border Style="{StaticResource RaceStatusTagStyle}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Style="{StaticResource RaceStatusTextStyle}" Margin="0,0,5,0"/>
                                                                            <TextBlock Text="{Binding Status, FallbackValue=ACTIVE}" Style="{StaticResource RaceStatusTextStyle}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                                <!-- Files spread across destinations, as discrete blocks -->
                                                                <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100" Height="6"
                                                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                             Style="{DynamicResource SegmentedMeterStyle}" Foreground="{DynamicResource Signature2Brush}"
                                                                             AutomationProperties.Name="Race progress"/>
                                                            </StackPanel>
                                                            <!-- Speed sparkline, relative to this race's own peak -->
                                                            <Border Grid.Column="2" Height="42" VerticalAlignment="Center"
                                                                    Background="{DynamicResource StreamMatrixHeaderBrush}" BorderBrush="{DynamicResource StreamGridLineBrush}" BorderThickness="1" ClipToBounds="True">
                                                                <ui:TelemetrySparkline Points="{Binding SparklinePoints}" YRange="40" Margin="1"/>
                                                            </Border>
                                                            <!-- Actions — gated by card state: live races get PAUSE/RESUME/STOP,
                                                                 finished (retained) cards get DISMISS -->
                                                            <WrapPanel Grid.Column="3" MaxWidth="300" VerticalAlignment="Center" Margin="14,0,0,0">
                                                                <!-- PAUSE: live + running only -->
                                                                <Button Content="PAUSE" Margin="0,0,6,0" Padding="10,5"
                                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <!-- RESUME: live + paused only -->
                                                                <Button Content="RESUME" Margin="0,0,6,0" Padding="10,5"
                                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.ResumeJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <!-- STOP: live races only -->
                                                                <Button Content="STOP"
                                                                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{DynamicResource DangerButtonStyle}" Padding="12,5"/>
                                                                <Button Content="RESET" Padding="10,5" Margin="6,0,0,0"
                                                                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                                                                        ToolTip="Clear retry failures at the next scan boundary; current transfers finish safely"
                                                                        Command="{Binding DataContext.ResetJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="RE-RACE" Padding="10,5" Margin="0,0,6,0"
                                                                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.ReRaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="CLEAN UP OWN PARTIAL" Padding="10,5" Margin="0,4,6,0"
                                                                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.CleanupOwnedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <!-- DISMISS: finished cards only — removes just this card -->
                                                                <Button Content="DISMISS" Padding="10,5"
                                                                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.DismissJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </WrapPanel>
                                                        </Grid>
                                                        <!-- Per-race detail: every file, every dest, and why each is or
                                                             isn't moving. Snapshotted only while expanded. -->
                                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}">
                                                            <Expander.Header>
                                                                <TextBlock Text="FILES + ROUTES" Style="{DynamicResource MicroTextStyle}"/>
                                                            </Expander.Header>
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding DetailSummary}"
                                                                           Style="{DynamicResource MicroTextStyle}"
                                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                <TextBlock Text="{Binding DetailRoutes}"
                                                                           Style="{DynamicResource MicroTextStyle}"
                                                                           FontFamily="Consolas" TextWrapping="NoWrap"
                                                                           Margin="0,0,0,10"/>
                                                                <DataGrid ItemsSource="{Binding DetailFiles}"
                                                                          AutoGenerateColumns="False" IsReadOnly="True"
                                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                                          Background="Transparent" BorderThickness="0"
                                                                          MaxHeight="320" FontSize="12"
                                                                          HorizontalScrollBarVisibility="Auto">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2.4*"/>
                                                                        <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat=N0}" Width="90"/>
                                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                                                        <DataGridTextColumn Header="On" Binding="{Binding OwnedBy, Converter={StaticResource JoinList}}" Width="*"/>
                                                                        <DataGridTextColumn Header="Missing from" Binding="{Binding MissingFrom, Converter={StaticResource JoinList}}" Width="*"/>
                                                                        <DataGridTextColumn Header="In flight to" Binding="{Binding InFlightTo, Converter={StaticResource JoinList}}" Width="*"/>
                                                                        <DataGridTextColumn Header="Fails" Binding="{Binding Failures}" Width="50"/>
                                                                        <DataGridTextColumn Header="Failed routes" Binding="{Binding FailedRoutes, Converter={StaticResource JoinList}}" Width="1.6*"/>
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </StackPanel>
                                                        </Expander>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <!-- Bottom split: Scoreboard + AutoRaceFeed -->
                        <Expander Grid.Row="1" Header="Site scoreboard and race activity" IsExpanded="False">
                        <Grid Height="190">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- SITE SCOREBOARD -->
                            <Border Grid.Column="0" Style="{DynamicResource HudPanelStyle}" Margin="0,0,5,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                        <TextBlock Text="SITE SCOREBOARD" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                    </Border>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                                            <ItemsControl ItemsSource="{Binding SpreadScoreboard}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SiteName}" Style="{DynamicResource DisplayTextStyle}" FontSize="13"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Style="{DynamicResource MicroTextStyle}">
                                                                    <Run Text="{Binding FilesOwned}"/><Run Text=" / "/><Run Text="{Binding FilesTotal}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding SpeedFormatted, FallbackValue=—}"
                                                                       Style="{DynamicResource MicroTextStyle}" Margin="0,0,8,0"/>
                                                            <Border Grid.Column="3" Style="{DynamicResource TagAccentStyle}">
                                                                <TextBlock Text="{Binding Status, FallbackValue=READY}" Style="{DynamicResource TagTextStyle}"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <!-- AUTO-RACE FEED -->
                            <Border Grid.Column="1" Style="{DynamicResource HudPanelStyle}" Margin="5,0,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                        <TextBlock Text="AUTO-RACE FEED" Style="{DynamicResource SectionHeaderTextStyle}"/>
                                    </Border>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                                            <ItemsControl ItemsSource="{Binding AutoRaceFeed}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                            <TextBlock Text="{Binding Timestamp}" Style="{DynamicResource MicroTextStyle}" Width="70"/>
                                                            <TextBlock Text="{Binding Action}" Style="{DynamicResource AccentTextStyle}" FontSize="12" Width="80"/>
                                                            <TextBlock Text="{Binding Release}" Style="{DynamicResource MicroTextStyle}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                        </Expander>
                        <Expander Grid.Row="2" Header="Race history" IsExpanded="False" Margin="0,6,0,0">
                            <DataGrid ItemsSource="{Binding RaceHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" MaxHeight="260" HeadersVisibility="Column"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                      BorderBrush="{DynamicResource LineBrush}" SelectionMode="Single"
                                      AutomationProperties.Name="Race history">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95"/>
                                    <DataGridTextColumn Header="Release" Binding="{Binding Release}" Width="*"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80"/>
                                    <DataGridTextColumn Header="Stop reason" Binding="{Binding StopReason}" Width="95"/>
                                    <DataGridTextColumn Header="Failure" Binding="{Binding FailureCategory}" Width="95"/>
                                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Details" Padding="6,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ShowRaceDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Re-race" Padding="6,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ReRaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Clean up own partial" Padding="6,3"
                                                            Command="{Binding DataContext.CleanupOwnedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </Grid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Browse Tab -->
            <TabItem x:Name="BrowseTab" AutomationProperties.Name="Browse">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="12" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Browse" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <Border Margin="14" Style="{DynamicResource HudPanelStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                            <TextBlock Text="BROWSE" Style="{DynamicResource SectionHeaderTextStyle}"/>
                        </Border>
                        <Grid>
                            <DockPanel Margin="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left Pane -->
                        <DockPanel Grid.Column="0" Margin="0,0,6,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ComboBox Grid.ColumnSpan="2" ItemsSource="{Binding ServerList}" SelectedItem="{Binding LeftServer}"
                                          AutomationProperties.Name="Left server" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Left folder path" VerticalContentAlignment="Center" Margin="0,0,6,0">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding LeftGoCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Row="1" Grid.Column="1" Content="Go" Command="{Binding LeftGoCommand}"
                                        Padding="12,6" Style="{DynamicResource SecondaryButton}"/>
                            </Grid>
                            <Grid>
<DataGrid x:Name="BrowseLeftGrid" ItemsSource="{Binding LeftItems}"
                                      SelectedItem="{Binding SelectedLeftItem}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding LeftDoubleClickCommand}"
                                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="80"/>
                                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedFormatted}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=BrowseLeftGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Choose a source server" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Select a server above and enter a folder path. Double-click a folder to open it." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                        </DockPanel>
                        <!-- Center Buttons -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6">
                            <Button Content="FXP &#x2192;" Command="{Binding FxpRightCommand}"
                                    Padding="12,8" Margin="0,0,0,6" Style="{DynamicResource PrimaryButton}"/>
                            <Button Content="&#x2190; FXP" Command="{Binding FxpLeftCommand}"
                                    Padding="12,8" Style="{DynamicResource PrimaryButton}"/>
                        </StackPanel>
                        <!-- Right Pane -->
                        <DockPanel Grid.Column="2" Margin="6,0,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ComboBox Grid.ColumnSpan="2" ItemsSource="{Binding ServerList}" SelectedItem="{Binding RightServer}"
                                          AutomationProperties.Name="Right server" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Right folder path" VerticalContentAlignment="Center" Margin="0,0,6,0">
                                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RightGoCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Row="1" Grid.Column="1" Content="Go" Command="{Binding RightGoCommand}"
                                        Padding="12,6" Style="{DynamicResource SecondaryButton}"/>
                            </Grid>
                            <Grid>
<DataGrid x:Name="BrowseRightGrid" ItemsSource="{Binding RightItems}"
                                      SelectedItem="{Binding SelectedRightItem}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column" CanUserAddRows="False"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding RightDoubleClickCommand}"
                                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TruncatedCellText}"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="80"/>
                                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedFormatted}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=BrowseRightGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Choose a destination server" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Select a server and folder, then use the transfer arrows to copy selected files between servers." FontSize="13" Margin="0,8,0,0" TextAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                        </DockPanel>
                    </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== SYSTEM group ===== -->
            <TabItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" Padding="14,3,14,0">
                <TabItem.Header>
                    <TextBlock Text="// SYSTEM" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                </TabItem.Header>
            </TabItem>

            <!-- Mounts Tab -->
            <TabItem x:Name="MountsTab" AutomationProperties.Name="Mounts">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="13" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Mounts" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <DockPanel Margin="12">
                    <!-- Top: Mount cards row -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Style="{DynamicResource HudPanelStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="MOUNT POINTS" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding MountedServerStatus}" Margin="14">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="280" Height="320" Margin="0,0,12,0"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <DockPanel Margin="16">
                                                            <!-- Title -->
                                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                                <TextBlock Text="{Binding Name}" Style="{DynamicResource DisplayTextStyle}" FontSize="15"/>
                                                                <TextBlock Text="{Binding Host}" Style="{DynamicResource MicroTextStyle}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding HealthLine}" Style="{DynamicResource MicroTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <!-- Action buttons -->
                                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                                <Button Content="OPEN" Style="{DynamicResource CyberpunkButtonStyle}" Margin="0,0,6,0" Padding="14,5"
                                                                        Command="{Binding DataContext.OpenMountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding ServerId}"/>
                                                                <Button Content="FLUSH" Style="{DynamicResource CyberpunkButtonStyle}" Margin="0,0,6,0" Padding="14,5"
                                                                        Command="{Binding DataContext.FlushMountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding ServerId}"/>
                                                                <!-- MOUNT: visible when not connected (IsMounted=false on
                                                                     OverviewServerVm — that's "any alive state including just-
                                                                     connected"; for the literal "drive letter mounted" we'd need
                                                                     a separate flag, but the button label "MOUNT" / "UNMOUNT"
                                                                     reads correctly given the user's mental model: MOUNT to bring
                                                                     online, UNMOUNT to take offline). -->
                                                                <Button Content="MOUNT" Padding="14,5"
                                                                        Command="{Binding DataContext.MountServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding ServerId}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMounted}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="UNMOUNT" Padding="14,5"
                                                                        Command="{Binding DataContext.UnmountServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding ServerId}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMounted}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                            <!-- Status tag (color-coded by SiteTag: green=alive, cyan=MOUNTED, red=offline) -->
                                                            <Border DockPanel.Dock="Bottom" Style="{DynamicResource ServerStatusTagStyle}" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                                <TextBlock Text="{Binding StatusLine}" Style="{DynamicResource ServerStatusTextStyle}"/>
                                                            </Border>
                                                            <!-- Big disc (Stroke + glow recoloring driven by SiteTag) -->
                                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Ellipse Width="130" Height="130" Stroke="{DynamicResource LineDimBrush}" StrokeThickness="2"/>
                                                                <Ellipse Width="130" Height="130" StrokeThickness="3"
                                                                        Style="{DynamicResource ServerStatusRingStyle}"
                                                                        StrokeDashArray="2,1.2" RenderTransformOrigin="0.5,0.5">
                                                                    <Ellipse.RenderTransform>
                                                                        <RotateTransform Angle="0"/>
                                                                    </Ellipse.RenderTransform>
                                                                    <Ellipse.Triggers>
                                                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                     From="0" To="360" Duration="0:0:16" RepeatBehavior="Forever"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Ellipse.Triggers>
                                                                </Ellipse>
                                                                <Ellipse Width="92" Height="92" Stroke="{DynamicResource LineDimBrush}" StrokeThickness="1"/>
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding CapacityPercent, StringFormat=N0}" Style="{DynamicResource DisplayTextStyle}" FontSize="28" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="%" Style="{DynamicResource DisplayTextStyle}" FontSize="18" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding CapacityUsedDisplay}" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="POOL SLOTS" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Center" FontSize="12" ToolTip="{Binding LoginUsageLine}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DockPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <!-- Bottom: Trusted certs table -->
                    <Border Style="{DynamicResource HudPanelStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource HudPanelHeaderStyle}">
                                <TextBlock Text="TRUSTED CERTS - TOFU" Style="{DynamicResource SectionHeaderTextStyle}"/>
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding TrustedCerts}" AutoGenerateColumns="False"
                                          Margin="14" Background="Transparent" HeadersVisibility="Column"
                                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="HOST" Binding="{Binding HostKey}" Width="240"/>
                                        <DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="*"/>
                                        <DataGridTextColumn Header="ISSUER" Binding="{Binding Issuer}" Width="*"/>
                                        <DataGridTextColumn Header="FINGERPRINT (SHA-256)" Binding="{Binding Fingerprint}" Width="220"/>
                                        <DataGridTextColumn Header="NOT AFTER" Binding="{Binding NotAfter}" Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- World Monitor Tab -->
            <TabItem AutomationProperties.Name="World Monitor">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="14" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="World Monitor" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <ui:WebViewHost x:Name="WorldMonitorHost"/>
            </TabItem>

            <!-- Discord Tab -->
            <TabItem AutomationProperties.Name="Discord">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="15" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Discord" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <ui:WebViewHost x:Name="DiscordHost"/>
            </TabItem>

            <!-- Streems Tab -->
            <TabItem AutomationProperties.Name="Streems">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="16" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Streems" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <ui:WebViewHost x:Name="StreemsHost"/>
            </TabItem>

            <!-- AI Agent Tab -->
            <TabItem AutomationProperties.Name="AI Agent">
                <TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="17" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="AI Agent" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem.Header>
                <ui:AgentView/>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Margin="10,4" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding HasBulkStatus, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoBulkCommand}" Margin="12,0,0,0"
                        Style="{DynamicResource PrimaryButton}" Visibility="{Binding HasPendingBulk, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding BulkStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- BOTTOM STATUS STRIP (live status; no simulated metrics)        -->
        <!-- IRC and disk usage are segments here (full IRC detail in the   -->
        <!-- tooltip; IRC actions stay on the IRC tab). Empty segments and  -->
        <!-- their separators are never drawn.                              -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource MarqueeBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <!-- Live (glowing mint) while anything transfers; a dim dot when idle. -->
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Effect" Value="{DynamicResource LiveSignalGlowEffect}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBarSpeed}" Value="Idle">
                                        <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}"/>
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusBarSpeed}" Value="">
                                        <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}"/>
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusBarSpeed}" Value="{x:Null}">
                                        <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}"/>
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="STATUS" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                </StackPanel>

                <Grid Grid.Column="1" ClipToBounds="True" Margin="18,0">
                    <TextBlock x:Name="StatusSegmentsText" VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}"
                               AutomationProperties.LiveSetting="Off">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource StatusSegments}">
                                <Binding Path="StatusBarSpeed"/>
                                <Binding Path="StatusBarQueueCount"/>
                                <Binding Path="StatusBarConnections"/>
                                <Binding Path="Irc.CompactStatusText"/>
                                <Binding Path="StatusBarDiskSpace"/>
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.ToolTip>
                            <MultiBinding Converter="{StaticResource StatusSegments}">
                                <Binding Path="StatusBarSpeed"/>
                                <Binding Path="StatusBarQueueCount"/>
                                <Binding Path="StatusBarConnections"/>
                                <Binding Path="Irc.StatusText"/>
                                <Binding Path="StatusBarDiskSpace"/>
                            </MultiBinding>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <!-- Live RTT / RX / TX. RxRateDisplay and TxRateDisplay are
                         driven by the same 2-second TickOverview that powers the
                         Overview tab's throughput panel; RxRateDisplay sums all
                         active download BytesPerSecond, TxRateDisplay sums all
                         spread-job non-source SpeedBps. StatusBarRtt comes from
                         the ConnectionMonitor average across mounted servers. -->
                    <!-- Fixed-width, right-aligned readouts so values do not shift their labels. -->
                    <TextBlock Text="RTT " FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}"/>
                    <TextBlock Text="{Binding StatusBarRtt, FallbackValue=--ms}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               MinWidth="48" TextAlignment="Right" AutomationProperties.Name="Round-trip time"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="&#x2193; " FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}"/>
                    <TextBlock Text="{Binding RxRateDisplay, FallbackValue=0.0 MB/s}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               MinWidth="92" TextAlignment="Right" AutomationProperties.Name="Download rate"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="&#x2191; " FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}"/>
                    <TextBlock Text="{Binding TxRateDisplay, FallbackValue=0.0 MB/s}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               MinWidth="92" TextAlignment="Right" AutomationProperties.Name="FXP transfer rate"
                               Foreground="{DynamicResource Signature2Brush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Keyboard shortcuts overlay (toggle with `?`) -->
        <Border x:Name="ShortcutsOverlay" Grid.RowSpan="4"
                Background="#CC03070D"
                Visibility="Collapsed" Panel.ZIndex="9999" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
                MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Border MaxWidth="640" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <StackPanel Margin="12">
                        <TextBlock Text="KEYBOARD SHORTCUTS"
                                   Style="{DynamicResource SectionHeaderTextStyle}"
                                   FontSize="16" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="?  /  Shift+/" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle this overlay" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Esc" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Close overlay" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Tab" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Next tab" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+Tab" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Previous tab" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Enter (IRC)" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Send message in the IRC input" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Tab (IRC)" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Nick completion / cycle through matches" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Delete (Downloads)" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Remove selected terminal history with Undo; local files stay" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="R (Downloads)" Style="{DynamicResource AccentTextStyle}" Margin="0,4"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Retry selected failed download(s)" Style="{DynamicResource DimTextStyle}" Margin="14,4"/>
                        </Grid>
                        <Button Content="Close shortcuts" Click="Shortcuts_Click" HorizontalAlignment="Center" Margin="0,18,0,0" Style="{DynamicResource SecondaryButton}"/>
                        <TextBlock Text="Press Esc or click to dismiss"
                                   Style="{DynamicResource MicroTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
