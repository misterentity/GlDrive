<Window x:Class="GlDrive.UI.OpsJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operations journal" Width="1180" Height="750" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Operations journal" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Read retained local operations and incident groups. This view makes no network requests or changes. Oldest events are evicted when retention limits are reached."
                       TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
            <WrapPanel>
                <TextBlock Text="Server ID (optional)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ServerBox" Width="230" MaxLength="256" Margin="0,0,12,0" AutomationProperties.Name="Operations server filter"/>
                <ComboBox x:Name="DaysBox" Width="100" SelectedIndex="1" Margin="0,0,12,0" AutomationProperties.Name="Operations time window">
                    <ComboBoxItem Content="1 day" Tag="1"/><ComboBoxItem Content="7 days" Tag="7"/>
                    <ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="90 days" Tag="90"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="12,6" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}"/>
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Padding="12,6" IsEnabled="False"
                        Style="{DynamicResource SecondaryButton}"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="Choose Refresh to read retained events." TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource ForegroundDimBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Timeline">
                <DataGrid x:Name="TimelineGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Operations timeline">
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="10"/></DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UTC time" Binding="{Binding Time, StringFormat={}{0:u}}" Width="170"/>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="Server" Binding="{Binding ServerId}" Width="120"/>
                        <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="120"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Incidents">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Events are grouped by exact server and nearby time. Select a group to inspect its context and up to 10 preceding configuration, update or agent changes from the same server or global scope. Nearby changes are context, not proof of cause."
                               TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <DataGrid x:Name="IncidentsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single" SelectionChanged="IncidentSelectionChanged"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Operations incidents">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="From UTC" Binding="{Binding FromUtc, StringFormat={}{0:u}}" Width="180"/>
                            <DataGridTextColumn Header="To UTC" Binding="{Binding ToUtc, StringFormat={}{0:u}}" Width="180"/>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerId}" Width="*"/>
                            <DataGridTextColumn Header="Event count" Binding="{Binding EventCount}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="IncidentEventsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,0"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Selected incident context">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="10"/></DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UTC time" Binding="{Binding Time, StringFormat={}{0:u}}" Width="180"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="150"/>
                            <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="150"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
