<Window x:Class="GlDrive.UI.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics and traffic ledger" Width="1220" Height="740" MinWidth="850" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Statistics and traffic ledger" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Read existing telemetry and race history. Refresh makes no site requests."
                       TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
            <WrapPanel>
                <TextBlock Text="Window" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DaysBox" Width="110" SelectedIndex="2" Margin="0,0,12,0"
                          AutomationProperties.Name="Statistics time window">
                    <ComboBoxItem Content="1 day" Tag="1"/>
                    <ComboBoxItem Content="7 days" Tag="7"/>
                    <ComboBoxItem Content="30 days" Tag="30"/>
                    <ComboBoxItem Content="90 days" Tag="90"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="12,6" Margin="0,0,12,0"
                        Style="{DynamicResource SecondaryButton}"/>
                <TextBlock x:Name="WindowText" Text="Choose Refresh to read the selected window." VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{DynamicResource ForegroundDimBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Races" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RaceText" Text="Not loaded." TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="CleanText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Clean rate uses only races with completion evidence. Missing evidence is excluded."
                                   TextWrapping="Wrap" Margin="0,8,0,18" Foreground="{DynamicResource ForegroundDimBrush}"/>
                        <TextBlock Text="Timing" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="LatencyGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="150"
                                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Observed race timings">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Measurement" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" Width="100"/>
                                <DataGridTextColumn Header="Median" Binding="{Binding Median}" Width="150"/>
                                <DataGridTextColumn Header="95th percentile" Binding="{Binding P95}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <TextBlock x:Name="DownloadsText" Text="Not loaded." TextWrapping="Wrap"/>
                        <TextBlock Text="Read coverage" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <TextBlock x:Name="CoverageText" Text="Not loaded." TextWrapping="Wrap"/>
                        <TextBlock x:Name="LimitsText" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Traffic by day">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Endpoint payload in decimal GB" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="A transfer can appear at both endpoints. These values describe payload, not network adapter usage or WAN billing."
                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
                        <TextBlock Text="Known relay subtotals are included in sent/received totals. Older rows may have unknown transport; those bytes are shown separately."
                                   TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
                        <TextBlock Text="Historical transfer rows without duplicate-skip evidence may overstate payload when a file was already present. Download GB is included in sent GB."
                                   TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </StackPanel>
                    <DataGrid x:Name="TrafficGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Daily endpoint traffic">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UTC day" Binding="{Binding DayUtc}" Width="100"/>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerId}" Width="150"/>
                            <DataGridTextColumn Header="Sent GB" Binding="{Binding SentGB, StringFormat={}{0:N3}}" Width="90"/>
                            <DataGridTextColumn Header="Received GB" Binding="{Binding ReceivedGB, StringFormat={}{0:N3}}" Width="105"/>
                            <DataGridTextColumn Header="Download GB" Binding="{Binding DownloadGB, StringFormat={}{0:N3}}" Width="105"/>
                            <DataGridTextColumn Header="Relay sent GB" Binding="{Binding RelaySentGB, StringFormat={}{0:N3}}" Width="110"/>
                            <DataGridTextColumn Header="Relay received GB" Binding="{Binding RelayReceivedGB, StringFormat={}{0:N3}}" Width="135"/>
                            <DataGridTextColumn Header="Unknown transport sent bytes" Binding="{Binding UnknownTransportSentBytes, StringFormat={}{0:N0}}" Width="205"/>
                            <DataGridTextColumn Header="Unknown transport received bytes" Binding="{Binding UnknownTransportReceivedBytes, StringFormat={}{0:N0}}" Width="225"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Routes">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="Route speeds use completed transfers with recorded duration. Rows without timing evidence remain unknown."
                               TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <DataGrid x:Name="RoutesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Observed route speeds">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                            <DataGridTextColumn Header="Completed transfers" Binding="{Binding CompletedTransfers}" Width="150"/>
                            <DataGridTextColumn Header="Payload bytes" Binding="{Binding Bytes, StringFormat={}{0:N0}}" Width="155"/>
                            <DataGridTextColumn Header="Timed transfers" Binding="{Binding TimedTransfers}" Width="125"/>
                            <DataGridTextColumn Header="Speed MiB/s" Binding="{Binding MiBPerSecond, StringFormat={}{0:N2}, TargetNullValue=Unknown}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Site observations">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="Pool samples show observation coverage. They cannot establish uptime between samples, so uptime is unknown. No connection or health probe is started."
                               TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    <DataGrid x:Name="HealthGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Site observation coverage">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerId}" Width="*"/>
                            <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" Width="90"/>
                            <DataGridTextColumn Header="Observed window hours" Binding="{Binding ObservedWindowHours, StringFormat={}{0:N2}}" Width="180"/>
                            <DataGridTextColumn Header="Window coverage %" Binding="{Binding WindowCoveragePercent, StringFormat={}{0:N1}}" Width="160"/>
                            <DataGridTextColumn Header="Uptime %" Binding="{Binding UptimePercent, TargetNullValue=Unknown}" Width="105"/>
                            <DataGridTextColumn Header="Last observation UTC" Binding="{Binding LastObservationUtc, StringFormat={}{0:u}, TargetNullValue=Unknown}" Width="190"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
