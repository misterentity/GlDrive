<Window x:Class="GlDrive.UI.IrcSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search IRC history" Width="1000" Height="600" MinWidth="600" MinHeight="350"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ServerLabel" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Search the last 30 days of channel logs with a regular expression. Results stay in this window." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" Click="Search_Click" IsDefault="True" Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0"/>
                <TextBox x:Name="PatternBox" MaxLength="512" AutomationProperties.Name="Regular expression" ToolTip="Case-insensitive regular expression"/>
            </DockPanel>
            <CheckBox x:Name="IncludePrivateBox" Content="Include private-message history (local only)" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusLabel" Text="Up to 200 matches. Searches stop after two seconds." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundDimBrush}"/>
        </StackPanel>
        <DataGrid x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended"
                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="150"/>
                <DataGridTextColumn Header="Conversation" Binding="{Binding Target}" Width="140"/>
                <DataGridTextColumn Header="Nick" Binding="{Binding Nick}" Width="120"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Text}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
