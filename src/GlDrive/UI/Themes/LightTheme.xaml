<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="#666666"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#FFCDD2"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FFEBEE"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E65100"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FFEBEE"/>

    <!-- Shared control states and semantic surface colors. -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#A62A26"/>
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#C83230"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#AD2927"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#777777"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#25743D"/>
    <SolidColorBrush x:Key="BadBrush" Color="#B42323"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#A64B00"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#616161"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#737373"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="LineDimBrush" Color="#ACACAC"/>
    <SolidColorBrush x:Key="Background0Brush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Background1Brush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Background2Brush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background3Brush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="SignatureBrush" Color="#C83230"/>
    <SolidColorBrush x:Key="Signature2Brush" Color="#7B1FA2"/>
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TopBarLogoBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="MarqueeBackgroundBrush" Color="#F5F5F5"/>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, monospace</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI</FontFamily>
    <Color x:Key="AccentColor">#E53935</Color>
    <!-- Multi-stream downloads: lane palette + stream matrix (deep tones for the Light theme). Keys must exist in every theme. -->
    <SolidColorBrush x:Key="LaneBrush0" Color="#0277BD"/>
    <SolidColorBrush x:Key="LaneBrush1" Color="#C2185B"/>
    <SolidColorBrush x:Key="LaneBrush2" Color="#2E7D32"/>
    <SolidColorBrush x:Key="LaneBrush3" Color="#EF6C00"/>
    <SolidColorBrush x:Key="LaneBrush4" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="LaneBrush5" Color="#D84315"/>
    <DropShadowEffect x:Key="LaneGlowEffect" Color="#000000" BlurRadius="4" ShadowDepth="0" Opacity="0.2"/>
    <sys:Double x:Key="LaneGlowOpacity">0.0</sys:Double>
    <SolidColorBrush x:Key="StreamMatrixBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StreamMatrixHeaderBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="StreamMatrixBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="StreamCellPendingBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="StreamCellCachedBrush" Color="#B0BEC5"/>
    <SolidColorBrush x:Key="StreamFileSeparatorBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="StreamGridLineBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="StreamSparkBrush" Color="#E53935"/>
    <LinearGradientBrush x:Key="StreamSparkFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40E53935"/>
        <GradientStop Offset="1" Color="#00E53935"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StreamTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="StreamTextDimBrush" Color="#666666"/>
    <SolidColorBrush x:Key="StreamTextFaintBrush" Color="#737373"/>
    <SolidColorBrush x:Key="StreamCommentBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="StreamGoodBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="StreamWarnBrush" Color="#E65100"/>
    <SolidColorBrush x:Key="StreamBadBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="StreamLedOnBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="StreamLedOffBrush" Color="#CFCFCF"/>
    <DropShadowEffect x:Key="StreamLedGlowEffect" Color="#2E7D32" BlurRadius="8" ShadowDepth="0" Opacity="0.0"/>
    <SolidColorBrush x:Key="StreamUsageBarBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="StreamUsageTrackBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="StreamChipBackgroundBrush" Color="#0A000000"/>
    <FontFamily x:Key="StreamMonoFontFamily">Cascadia Mono, Consolas, monospace</FontFamily>
</ResourceDictionary>
