    <SolidColorBrush x:Key="StreamTextFaintBrush" Color="#8197AD"/>
    <SolidColorBrush x:Key="StreamCommentBrush" Color="#4FB07A"/>
    <SolidColorBrush x:Key="StreamGoodBrush" Color="#7CFF66"/>
    <SolidColorBrush x:Key="StreamWarnBrush" Color="#FFAB1F"/>
    <SolidColorBrush x:Key="StreamBadBrush" Color="#FF3F63"/>
    <SolidColorBrush x:Key="StreamLedOnBrush" Color="#7CFF66"/>
