                <Setter Property="BorderBrush" Value="#80E6B76D"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownloadStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TagTextStyle}">
