    <!-- Marquee scroll storyboard: continuously translates X from 0 to -2400 over 60s.
         Target a TranslateTransform on the marquee TextBlock via RenderTransform. -->
    <Storyboard x:Key="MarqueeStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                        From="0" To="-2400" Duration="0:1:00"/>
    </Storyboard>

    <DrawingBrush x:Key="ScanlineOverlayBrush"
                  TileMode="Tile"
                  Viewport="0,0,1,4"
                  ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#55000000">
                    <GeometryDrawing.Geometry>
