    <SolidColorBrush x:Key="StreamMatrixBorderBrush" Color="#5500E5FF"/>
    <SolidColorBrush x:Key="StreamCellPendingBrush" Color="#0E2033"/>
    <SolidColorBrush x:Key="StreamCellCachedBrush" Color="#2A4A66"/>
    <SolidColorBrush x:Key="StreamFileSeparatorBrush" Color="#FF2AB8"/>
    <SolidColorBrush x:Key="StreamGridLineBrush" Color="#1A3550"/>
    <SolidColorBrush x:Key="StreamSparkBrush" Color="#00E5FF"/>
    <LinearGradientBrush x:Key="StreamSparkFillBrush" StartPoint="0,0" EndPoint="0,1">
