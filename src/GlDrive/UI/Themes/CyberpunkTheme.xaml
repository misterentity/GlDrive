    <!-- Top bar logo block background (cyan-tinted horizontal fade) -->
    <LinearGradientBrush x:Key="TopBarLogoBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#2000E5FF"/>
