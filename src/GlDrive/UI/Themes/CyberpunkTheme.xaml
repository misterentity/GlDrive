    <Style x:Key="TagAccentStyle" TargetType="Border" BasedOn="{StaticResource TagStyle}">
        <Setter Property="Background" Value="#1500E5FF"/>
        <Setter Property="BorderBrush" Value="#8000E5FF"/>
    </Style>

    <Style x:Key="TagGoodStyle" TargetType="Border" BasedOn="{StaticResource TagStyle}">
        <Setter Property="Background" Value="#157CFF66"/>
        <Setter Property="BorderBrush" Value="#807CFF66"/>
