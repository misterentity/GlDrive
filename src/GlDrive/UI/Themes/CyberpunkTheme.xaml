    <SolidColorBrush x:Key="LaneBrush4" Color="#B388FF"/>
    <SolidColorBrush x:Key="LaneBrush5" Color="#FF6A3D"/>
    <DropShadowEffect x:Key="LaneGlowEffect" Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
    <sys:Double x:Key="LaneGlowOpacity">0.85</sys:Double>
