<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#282828"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="#888888"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#4E1A1A"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2A1515"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#662222"/>
    <Color x:Key="AccentColor">#E53935</Color>
    <!-- Multi-stream downloads: lane palette + stream matrix (muted for the Dark theme). Keys must exist in every theme. -->
    <SolidColorBrush x:Key="LaneBrush0" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="LaneBrush1" Color="#F06292"/>
    <SolidColorBrush x:Key="LaneBrush2" Color="#81C784"/>
    <SolidColorBrush x:Key="LaneBrush3" Color="#FFB74D"/>
    <SolidColorBrush x:Key="LaneBrush4" Color="#BA68C8"/>
    <SolidColorBrush x:Key="LaneBrush5" Color="#FF8A65"/>
    <DropShadowEffect x:Key="LaneGlowEffect" Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
    <sys:Double x:Key="LaneGlowOpacity">0.35</sys:Double>
    <SolidColorBrush x:Key="StreamMatrixBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="StreamMatrixHeaderBrush" Color="#202020"/>
    <SolidColorBrush x:Key="StreamMatrixBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="StreamCellPendingBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="StreamCellCachedBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="StreamFileSeparatorBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="StreamGridLineBrush" Color="#303030"/>
    <SolidColorBrush x:Key="StreamSparkBrush" Color="#E53935"/>
    <LinearGradientBrush x:Key="StreamSparkFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#55E53935"/>
        <GradientStop Offset="1" Color="#00E53935"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StreamTextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="StreamTextDimBrush" Color="#888888"/>
    <SolidColorBrush x:Key="StreamTextFaintBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="StreamCommentBrush" Color="#7FA37F"/>
    <SolidColorBrush x:Key="StreamGoodBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="StreamWarnBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="StreamBadBrush" Color="#EF5350"/>
    <SolidColorBrush x:Key="StreamLedOnBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="StreamLedOffBrush" Color="#3A3A3A"/>
    <DropShadowEffect x:Key="StreamLedGlowEffect" Color="#66BB6A" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
    <SolidColorBrush x:Key="StreamUsageBarBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="StreamUsageTrackBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="StreamChipBackgroundBrush" Color="#14FFFFFF"/>
    <FontFamily x:Key="StreamMonoFontFamily">Cascadia Mono, Consolas, monospace</FontFamily>
</ResourceDictionary>
